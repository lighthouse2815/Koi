@layout PublicLayout
@inject LinkGenerator Links

<PageTitle>Thực đơn · KOI Thé</PageTitle>

<SectionContent SectionName="Styles">
    <script>
        if (!location.hash) {
            history.scrollRestoration = "manual";
            scrollTo({ top: 0, behavior: "instant" });
        }
    </script>
    <link rel="stylesheet" href="/css/content-pages.css" />
    <link rel="stylesheet" href="/css/menu.css" />
</SectionContent>
<div class="content-page" id="home">
    <div class="menuListWrap">
        <div class="head-area">
            <h1 class="en">THỰC ĐƠN</h1>
        </div>
        <section class="menu-gallery" aria-labelledby="menu-country">
            <h2 class="en" id="menu-country">VIỆT NAM</h2>
            <ul class="menu-gallery__list">
                @foreach (var menu in Model)
                {
                    var imageLink = ComponentImageLinks.ForNavigation(menu.File);
                    <li>
                        <a class="menu-gallery__photo" href="@imageLink" aria-label="Mở ảnh thực đơn @menu.Label" data-menu-photo>
                            <img src="@imageLink" alt="Thực đơn @menu.Label" />
                            <span>@menu.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
        <div class="back"><a href="@(Links.GetPathByAction("OurTea", "Home"))" class="flex-container align-middle" aria-label="Quay lại Trà của KOI"><span class="localized-control-text"><span class="control-arrow" aria-hidden="true">←</span>( Quay lại )</span>
                <svg class="show-for-large" xmlns="http://www.w3.org/2000/svg" width="54.15" height="47.14" viewBox="0 0 54.15 47.14" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="21.22" width="48.52" height="4.68"></rect>
                            <path class="d" d="M16.5,46.05c-.7-1.09-.37-2.54,.72-3.23l30.23-19.25L17.22,4.31c-1.09-.7-1.42-2.15-.72-3.23s2.15-1.4,3.24-.72L53.07,21.59c.67,.43,1.08,1.18,1.08,1.98s-.41,1.55-1.08,1.98L19.74,46.77c-.39,.25-.83,.37-1.26,.37-.77,0-1.53-.38-1.98-1.08Z"></path>
                        </g>
                    </g>
                </svg>
                <svg class="hide-for-large" xmlns="http://www.w3.org/2000/svg" width="38.68" height="33.67" viewBox="0 0 38.68 33.67" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="15.16" width="34.66" height="3.35"></rect>
                            <path class="d" d="M11.79,32.9c-.5-.78-.26-1.81,.52-2.31l21.59-13.75L12.3,3.08c-.78-.5-1.01-1.53-.52-2.31s1.54-1,2.31-.51l23.81,15.16c.48,.31,.77,.84,.77,1.41s-.29,1.1-.77,1.41l-23.81,15.16c-.28,.18-.59,.26-.9,.26-.55,0-1.09-.27-1.42-.77Z"></path>
                        </g>
                    </g>
                </svg>
                <span class="text">TRÀ CỦA KOI</span>
            </a></div>
    </div>
</div>
@if (Model.Count > 0)
{
    <dialog class="menu-viewer" id="menu-viewer" aria-label="Ảnh thực đơn" aria-describedby="menu-viewer-help">
        <p class="visually-hidden" id="menu-viewer-help">Dùng phím + hoặc − để phóng to hoặc thu nhỏ, phím mũi tên để di chuyển và Escape để đóng.</p>
        <div class="menu-viewer__viewport" tabindex="0" autofocus>
            <img class="menu-viewer__image" alt="" draggable="false" />
        </div>
    </dialog>
}
<SectionContent SectionName="VendorScripts">
    <script src="/lib/gsap/gsap.min.js" defer></script>
    <script src="/lib/gsap/ScrollTrigger.min.js" defer></script>
</SectionContent>
<SectionContent SectionName="Scripts">
    <script src="/js/content-pages.js" defer></script>
    <script src="/js/menu-viewer.js" defer></script>
</SectionContent>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Menu> Model { get; set; } = default!;
}
