@layout AdminLayout
@inject LinkGenerator Links

<PageTitle>Đơn hàng · KOI Admin</PageTitle>
<SectionContent SectionName="AdminTitle">Đơn hàng</SectionContent>

@{
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<div class="page-heading admin-page-heading">
    <div class="admin-heading-title"><span class="admin-heading-icon"><AdminIcon Name="receipt" /></span><h1>Đơn hàng</h1></div>
</div>
<form method="get" class="search">
    <div class="search-field search-field--wide">
        <label for="storeId">Chi nhánh</label>
        <select id="storeId" name="storeId">
            <option value="">Tất cả chi nhánh</option>
            @foreach (var branch in Model.Branches)
            {
                <option value="@branch.Id" selected="@(branch.Id == Model.StoreId)">@branch.Name · @branch.Address</option>
            }
        </select>
    </div>
    <div class="search-field">
        <label for="status">Trạng thái</label>
        <select id="status" name="status">
            <option value="">Tất cả trạng thái</option>
            @foreach (var status in Enum.GetValues<OrderStatus>())
            {
                <option value="@((int)status)" selected="@(status == Model.Status)">@(status switch
                {
                    OrderStatus.New => "Mới",
                    OrderStatus.Preparing => "Đang chuẩn bị",
                    OrderStatus.Completed => "Hoàn thành",
                    _ => "Đã hủy"
                })</option>
            }
        </select>
    </div>
    <button type="submit" class="button secondary"><AdminIcon Name="filter" /> Lọc đơn hàng</button>
</form>
<div class="table-wrap" tabindex="0" role="region" aria-label="Danh sách đơn hàng">
    <table>
        <thead>
            <tr>
                <th scope="col"><span class="admin-column"><AdminIcon Name="clock" /> Thời gian (UTC)</span></th>
                <th scope="col"><span class="admin-column"><AdminIcon Name="store" /> Chi nhánh</span></th>
                <th scope="col"><span class="admin-column"><AdminIcon Name="user" /> Khách hàng</span></th>
                <th scope="col"><span class="admin-column"><AdminIcon Name="wallet" /> Tổng tiền món</span></th>
                <th scope="col"><span class="admin-column"><AdminIcon Name="status" /> Trạng thái</span></th>
                <th scope="col"><span class="admin-column"><AdminIcon Name="settings" /> Thao tác</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr data-row-preview>
                    <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><strong>@order.StoreName</strong></td>
                    <td>@order.CustomerName</td>
                    <td class="amount">@order.Items.Sum(item => item.UnitPrice * item.Quantity).ToString("N0", culture) đ</td>
                    <td><AdminOrderStatus Status="@order.Status" /></td>
                    <td>
                        <div class="row-actions">
                            <button type="button" data-row-preview-trigger data-row-preview-title="Chi tiết đơn hàng"
                                    data-row-preview-url="@(Links.GetPathByAction("Details", "Orders", new { area = "Admin", id = order.Id, preview = true }))"
                                    aria-label="Xem đơn của @order.CustomerName" hidden><AdminIcon Name="eye" /> Xem</button>
                            <a href="@(Links.GetPathByAction("Details", "Orders", new { area = "Admin", id = order.Id }))"><AdminIcon Name="receipt" /> Mở đơn</a>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Orders.Count == 0)
            {
                <tr><td colspan="6" class="empty-state">Không có đơn hàng phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>
<nav class="pagination" aria-label="Phân trang">
    @if (Model.Page > 1)
    {
        <a href="@(Links.GetPathByAction("Index", "Orders", new { area = "Admin", storeId = Model.StoreId, status = Model.Status, page = Model.Page - 1 }))">← Trước</a>
    }
    <span>Trang @Model.Page / @Model.PageCount</span>
    @if (Model.Page < Model.PageCount)
    {
        <a href="@(Links.GetPathByAction("Index", "Orders", new { area = "Admin", storeId = Model.StoreId, status = Model.Status, page = Model.Page + 1 }))">Sau →</a>
    }
</nav>

<RowPreviewDialog />

@code {
    [Parameter, EditorRequired] public Koi.Web.Models.OrderListViewModel Model { get; set; } = default!;
}
