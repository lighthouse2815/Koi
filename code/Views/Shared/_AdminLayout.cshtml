@{
    var isAdmin = User.IsInRole("Admin");
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var navigation = new[]
    {
        (Label: "Tổng quan", Links: new[] { (Controller: "Dashboard", Label: "Dashboard") }),
        (Label: "Nội dung", Links: new[]
        {
            (Controller: "News", Label: "Tin tức"),
            (Controller: "Menus", Label: "Thực đơn"),
            (Controller: "Drinks", Label: "Đồ uống"),
            (Controller: "Category", Label: "Danh mục"),
            (Controller: "FeaturedDrinks", Label: "New Drinks")
        }),
        (Label: "Vận hành", Links: new[]
        {
            (Controller: "Stores", Label: "Chi nhánh"),
            (Controller: "StoreCities", Label: "Khu vực"),
            (Controller: "Orders", Label: "Đơn hàng")
        })
    };
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] · KOI Admin</title>
    <link rel="icon" href="~/images/favicon.png" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="admin-skip" href="#admin-content">Đến nội dung chính</a>
    <div class="@(isAdmin ? "admin-shell" : "admin-guest")">
        @if (isAdmin)
        {
            <aside class="admin-sidebar">
                <div class="admin-sidebar-head">
                    <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <img src="~/images/logo.svg" width="132" height="28" alt="KOI Thé" />
                        <span>Quản trị website</span>
                    </a>
                    <button type="button" class="button secondary admin-menu-toggle" aria-controls="admin-menu" aria-expanded="false" hidden>Menu</button>
                </div>
                <div class="admin-sidebar-content" id="admin-menu">
                    <nav class="admin-nav" aria-label="Điều hướng quản trị">
                        @foreach (var group in navigation)
                        {
                            <div class="admin-nav-group">
                                <p>@group.Label</p>
                                @foreach (var item in group.Links)
                                {
                                    var isActive = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                                    <a asp-area="Admin" asp-controller="@item.Controller" asp-action="Index" aria-current="@(isActive ? "true" : null)">@item.Label</a>
                                }
                            </div>
                        }
                    </nav>
                    <div class="admin-profile">
                        <div>
                            <strong>Quản trị viên</strong>
                            <span>@User.Identity?.Name</span>
                        </div>
                        <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="button secondary">Đăng xuất</button>
                        </form>
                    </div>
                </div>
            </aside>
        }
        <div class="admin-workspace">
            <header class="admin-topbar">
                @if (isAdmin)
                {
                    <div class="admin-breadcrumb">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Quản trị</a>
                        <span aria-hidden="true">/</span>
                        <span>@ViewData["Title"]</span>
                    </div>
                }
                else
                {
                    <a class="admin-brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <img src="~/images/logo.svg" width="132" height="28" alt="KOI Thé" />
                    </a>
                }
                <a class="button secondary admin-site-link" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">Xem website <span aria-hidden="true">↗</span></a>
            </header>
            <main class="admin-main" id="admin-content" tabindex="-1">
                @if (TempData["Status"] is string status)
                {
                    <p class="status" role="status">@status</p>
                }
                @RenderBody()
            </main>
        </div>
    </div>
    @if (isAdmin)
    {
        <script src="~/js/admin-navigation.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/admin-upload.js" asp-append-version="true" defer></script>
</body>
</html>
