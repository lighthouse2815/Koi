@{
    var pages = new[]
    {
        (Label: "HOME", Url: Url.Action("Index", "Home")!),
        (Label: "ABOUT", Url: Url.Action("About", "Home")!),
        (Label: "OUR TEA", Url: Url.Action("OurTea", "Home")!),
        (Label: "NEWS", Url: Url.Action("News", "Home")!),
        (Label: "STORE", Url: Url.Action("Store", "Home")!),
        (Label: "RECRUIT", Url: Url.Action("Recruit", "Home")!),
        (Label: "IMPACT", Url: Url.Action("Impact", "Home")!),
        (Label: "CONTACT", Url: Url.Action("Contact", "Home")!)
    };
    var currentUrl = Context.Request.Path.Value;
    if (Context.GetRouteValue("action")?.ToString() is "NewsDetail" or "NewsPreview") currentUrl = Url.Action("News", "Home");
    if (Context.GetRouteValue("action")?.ToString() == "Menu") currentUrl = Url.Action("OurTea", "Home");
    if (Context.GetRouteValue("action")?.ToString() is "Responsibility" or "Precision" or "People" or "Connections") currentUrl = Url.Action("Impact", "Home");
    var currentIndex = Array.FindIndex(pages, page => string.Equals(page.Url, currentUrl, StringComparison.OrdinalIgnoreCase));
    if (currentIndex < 0) currentIndex = 0;
    var current = pages[currentIndex];
}
<header class="site-header">
    <a class="current-page" href="@current.Url" aria-label="@T[current.Label], @T["Navigation page {0} of {1}", currentIndex + 1, 8]" aria-current="page">
        <img src="~/images/page-icon.svg" width="36" height="35" alt="" />
        <span class="page-marker" aria-hidden="true">▸</span>
        <span>@T[current.Label] <i>(@((currentIndex + 1).ToString("D2"))/08)</i></span>
    </a>
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="@T["KOI Thé home"]">
        <picture>
            <source media="(max-width: 1024px)" srcset="/images/logo-mobile.svg" />
            <img src="~/images/logo.svg" width="184" height="39" alt="@T["KOI Thé"]" />
        </picture>
    </a>
    <nav class="fan-navigation" aria-label="@T["Main navigation"]">
        <button class="menu-toggle" type="button" aria-label="@T["Open navigation menu"]" aria-haspopup="dialog" aria-controls="navigation-dialog">
            <span class="mobile-menu-label"><img src="~/images/hamburger.svg" width="23" height="17" alt="" /></span>
        </button>
        <ul class="fan-links">
            @foreach (var navItem in pages)
            {
                <li><a href="@navItem.Url" aria-current="@(navItem.Label == current.Label ? "page" : null)">@T[navItem.Label]</a></li>
            }
        </ul>
    </nav>
</header>
<dialog class="navigation-dialog" id="navigation-dialog" aria-labelledby="navigation-title">
    <div class="dialog-heading">
        <span id="navigation-title">@T["EXPLORE KOI"]</span>
        <button class="menu-close" type="button" aria-label="@T["Close navigation menu"]">×</button>
    </div>
    <nav aria-label="@T["Expanded navigation"]">
        @foreach (var navItem in pages)
        {
            <a href="@navItem.Url" aria-current="@(navItem.Label == current.Label ? "page" : null)"><span>@T[navItem.Label]</span><span aria-hidden="true">↗</span></a>
        }
    </nav>
    <div class="dialog-bottom"><span>@T["YOUR DAILY BEAT."]</span><partial name="_LanguageSwitcher" /></div>
</dialog>
