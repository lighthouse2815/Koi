@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}
<section class="error-page">
    <h1>Vui lòng thử lại.</h1>
    <p>Không tải được trang này. Hãy tải lại hoặc quay về trang chủ.</p>
    <a asp-controller="Home" asp-action="Index">Về trang chủ KOI Thé →</a>
    @if (Model.ShowRequestId)
    {
        <p>Mã tham chiếu: <code>@Model.RequestId</code></p>
    }
</section>
