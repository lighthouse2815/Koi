@model FeaturedDrinkEditViewModel

<dialog id="featured-editor" class="drink-editor" aria-labelledby="featured-editor-title">
    <div class="page-heading">
        <h2 id="featured-editor-title">Thêm New Drinks</h2>
        <button type="button" class="button secondary" data-featured-cancel>Đóng</button>
    </div>
    <form asp-action="Create" method="post" class="editor" data-upload-folder="featured-drinks" data-ajax-save
          data-create-url="@Url.Action("Create")">
        <fieldset class="upload-fields" disabled>
            <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="editor-columns">
                <div class="card">
                    <label asp-for="Name">Tên đồ uống / bộ sưu tập</label><input asp-for="Name" maxlength="250" required />
                    <label for="ImageUpload">Ảnh đồ uống</label><img class="current-image" data-featured-image alt="Ảnh hiện tại" hidden />
                    <input asp-for="ImageUploadId" type="hidden" /><input id="ImageUpload" type="file" accept="image/jpeg,image/png,image/webp" />
                    <label for="BackgroundUpload">Ảnh nền</label><img class="current-image" data-featured-background alt="Ảnh nền hiện tại" hidden />
                    <input asp-for="BackgroundUploadId" type="hidden" /><input id="BackgroundUpload" type="file" accept="image/jpeg,image/png,image/webp" />
                    <p class="help">Mỗi ảnh JPG, PNG hoặc WebP tối đa 5 MB. Khi sửa, để trống để giữ ảnh cũ.</p>
                </div>
                <aside class="card">
                    <label class="check"><input asp-for="IsPublished" /> Hiển thị trên Our Tea</label>
                    <label asp-for="SortOrder">Thứ tự</label><input asp-for="SortOrder" type="number" min="0" max="100000" />
                    <p class="help">Số nhỏ hiển thị trước.</p>
                    <button class="button" type="submit">Lưu New Drinks</button>
                    <a asp-action="Index" data-featured-reload hidden>Tải lại bản mới nhất</a>
                </aside>
            </div>
        </fieldset>
    </form>
</dialog>
