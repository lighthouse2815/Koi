@model FeaturedDrink[]
@{ ViewData["Title"] = "New Drinks"; }
<div class="page-heading"><h1>New Drinks</h1><a asp-action="Create" class="button">+ Thêm mục</a></div>
<p><a asp-controller="Drinks">Đồ uống</a> · <a asp-controller="Category">Danh mục</a></p>
<p>Ảnh, nền và tên tại phần New Drinks trên Our Tea chuyển cùng nhau theo thứ tự dưới đây.</p>
<div class="table-wrap"><table><thead><tr><th>Tên</th><th>Thứ tự</th><th>Hiển thị</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td><div class="article-cell"><img src="@item.Image" alt="" loading="lazy" /><strong>@item.Name</strong></div></td><td>@item.SortOrder</td><td>@(item.IsPublished ? "Đã xuất bản" : "Bản nháp")</td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@item.Id">Sửa</a><a asp-action="Delete" asp-route-id="@item.Id">Xóa</a></div></td></tr>
}
</tbody></table></div>
@if (Model.Length == 0) { <p>Chưa có mục New Drinks.</p> }
