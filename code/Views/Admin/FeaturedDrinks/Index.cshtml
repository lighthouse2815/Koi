@model FeaturedDrink[]
@{ ViewData["Title"] = "New Drinks"; }
<div class="page-heading">
    <h1>New Drinks</h1><button type="button" class="button" data-featured-create>+ Thêm mục</button>
</div>
<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa mục New Drinks.</p></noscript>
<p><a asp-controller="Drinks">Đồ uống</a> · <a asp-controller="Category">Danh mục</a></p>
<p>Ảnh, nền và tên tại phần New Drinks trên Our Tea chuyển cùng nhau theo thứ tự dưới đây.</p>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Tên</th>
                <th>Thứ tự</th>
                <th>Hiển thị</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="article-cell"><img src="@item.Image" alt="" loading="lazy" /><strong>@item.Name</strong></div>
                    </td>
                    <td>@item.SortOrder</td>
                    <td>@(item.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="link-button" data-featured-edit
                                    data-url="@Url.Action("Edit", new { id = item.Id })"
                                    data-id="@item.Id" data-revision="@item.Revision" data-name="@item.Name"
                                    data-sort-order="@item.SortOrder" data-is-published="@item.IsPublished.ToString().ToLowerInvariant()"
                                    data-image="@item.Image" data-background="@item.BackgroundImage">Sửa</button>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="delete-link" data-name="@item.Name">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Length == 0) { <p>Chưa có mục New Drinks.</p> }

<partial name="_DeleteDialog" />
<partial name="Edit" model="new FeaturedDrinkEditViewModel()" />
<script src="~/js/featured-drink-editor.js" asp-append-version="true" defer></script>
