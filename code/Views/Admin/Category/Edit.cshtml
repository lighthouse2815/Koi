@model CategoryEditViewModel

<dialog id="category-editor" class="category-editor" aria-labelledby="category-editor-title">
    <div class="page-heading">
        <h2 id="category-editor-title">Thêm danh mục</h2>
        <button type="button" class="button secondary" data-category-cancel>Đóng</button>
    </div>
    <form asp-action="Create" method="post" class="editor" data-upload-folder="categories" data-ajax-save
          data-create-url="@Url.Action("Create")" data-edit-url="@Url.Action("Edit")">
        <fieldset class="upload-fields" disabled>
            <input asp-for="Id" type="hidden" />
            <input asp-for="Revision" type="hidden" />
            <div asp-validation-summary="All" class="validation category-save-error" role="alert"></div>
            <div class="editor-columns">
                <div class="card">
                    <label asp-for="Name">Tên danh mục</label>
                    <input asp-for="Name" maxlength="200" required />

                    <label for="ImageUpload">Ảnh danh mục và thẻ trang chủ</label>
                    <img class="current-image" alt="Ảnh danh mục" hidden />
                    <input asp-for="ImageUploadId" type="hidden" />
                    <input id="ImageUpload" type="file" accept="image/jpeg,image/png,image/webp" />

                    <label for="IconUpload">Biểu tượng danh mục trên trang chủ</label>
                    <img class="current-icon" alt="Biểu tượng danh mục" hidden />
                    <input asp-for="IconUploadId" type="hidden" />
                    <input id="IconUpload" type="file" accept="image/jpeg,image/png,image/webp" />
                    <label class="check"><input asp-for="RemoveIcon" /> Bỏ biểu tượng danh mục</label>
                    <p class="help">Mỗi ảnh JPG, PNG hoặc WebP tối đa 5 MB. Để trống để giữ ảnh hiện tại. Bật thẻ trang chủ cần có cả ảnh và biểu tượng thẻ.</p>
                </div>
                <aside class="card">
                    <label class="check"><input asp-for="IsPublished" /> Hiển thị danh mục và đồ uống bên trong</label>
                    <label class="check"><input asp-for="ShowOnHome" /> Hiển thị thẻ trên trang chủ</label>
                    <label asp-for="SortOrder">Thứ tự hiển thị</label>
                    <input asp-for="SortOrder" type="number" min="0" max="100000" />
                    <button class="button" type="submit">Lưu danh mục</button>
                    <a asp-action="Index" data-category-reload hidden>Tải lại bản mới nhất</a>
                </aside>
            </div>
        </fieldset>
    </form>
</dialog>
