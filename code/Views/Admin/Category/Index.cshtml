@model IReadOnlyList<Category>

@{ ViewData["Title"] = "Danh mục đồ uống"; }

<div class="category-page">
    <header class="page-heading admin-page-heading">
        <div class="admin-heading-title">
            <span class="admin-heading-icon"><partial name="_AdminIcon" model='"layers"' /></span>
            <div>
                <h1>Danh mục đồ uống</h1>
                <nav class="category-related" aria-label="Quản lý đồ uống">
                    <a asp-controller="Drinks">Đồ uống</a><span aria-hidden="true">·</span><a asp-controller="FeaturedDrinks">New Drinks</a>
                </nav>
            </div>
        </div>
        <button type="button" class="button" data-category-create><partial name="_AdminIcon" model='"plus"' /> Thêm danh mục</button>
    </header>

<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa danh mục.</p></noscript>

<p class="category-scroll-hint">Vuốt ngang để xem thêm <span aria-hidden="true">→</span></p>
<div class="table-wrap category-table-wrap" tabindex="0" role="region" aria-label="Bảng danh mục đồ uống">
    <table>
        <thead>
            <tr>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"order"' /> Thứ tự</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"layers"' /> Danh mục</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"image"' /> Ảnh</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"cup"' /> Biểu tượng</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"home"' /> Trang chủ</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"settings"' /> Thao tác</span></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var category in Model)
            {
                <tr data-row-preview>
                    <td><span class="category-order">@category.SortOrder</span></td>
                    <td class="category-name">@category.Name</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(category.Image))
                        {
                            <img class="category-thumbnail" src="@category.Image" alt="Ảnh @category.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="category-missing">Chưa có</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(category.Icon))
                        {
                            <img class="category-thumbnail category-thumbnail--icon" src="@category.Icon" alt="Biểu tượng @category.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="category-missing">Chưa có</span>
                        }
                    </td>
                    <td><span class="category-home">@(category.ShowOnHome ? "thứ tự " + category.SortOrder : "Không")</span></td>
                    <td>
                        <div class="row-actions">
                            <button type="button" data-row-preview-trigger aria-label="Xem thông tin @category.Name" hidden><partial name="_AdminIcon" model='"eye"' /> Xem</button>
                            <button type="button" data-category-edit
                                    data-id="@category.Id" data-revision="@category.Revision" data-name="@category.Name"
                                    data-sort-order="@category.SortOrder"
                                    data-show-on-home="@category.ShowOnHome.ToString().ToLowerInvariant()"
                                    data-image="@category.Image" data-icon="@category.Icon"><partial name="_AdminIcon" model='"edit"' /> Sửa</button>
                            <a asp-area="" asp-controller="Home" asp-action="OurTea" asp-fragment="@category.Id.ToString()" target="_blank" rel="noopener"><partial name="_AdminIcon" model='"external"' /> Xem website</a>
                            <a asp-action="Delete" asp-route-id="@category.Id" class="delete-link" data-name="@category.Name"><partial name="_AdminIcon" model='"trash"' /> Xóa</a>
                        </div>
                        <template data-row-preview-content data-title="@category.Name">
                            <dl class="row-preview-details">
                                <div><dt>Thứ tự</dt><dd>@category.SortOrder</dd></div>
                                <div><dt>Hiển thị trên trang chủ</dt><dd>@(category.ShowOnHome ? "Có" : "Không")</dd></div>
                                <div>
                                    <dt>Ảnh danh mục</dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(category.Image))
                                        {
                                            <img class="row-preview-image" src="@category.Image" alt="Ảnh @category.Name" />
                                        }
                                        else
                                        {
                                            <span>Chưa có ảnh</span>
                                        }
                                    </dd>
                                </div>
                                <div>
                                    <dt>Biểu tượng</dt>
                                    <dd>
                                        @if (!string.IsNullOrWhiteSpace(category.Icon))
                                        {
                                            <img class="row-preview-image category-thumbnail--icon" src="@category.Icon" alt="Biểu tượng @category.Name" />
                                        }
                                        else
                                        {
                                            <span>Chưa có biểu tượng</span>
                                        }
                                    </dd>
                                </div>
                            </dl>
                        </template>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0) { <p class="category-empty">Chưa có danh mục.</p> }

<partial name="_RowPreviewDialog" />
<partial name="_DeleteDialog" />
<partial name="Edit" model="new CategoryEditViewModel()" />
<script src="~/js/category-editor.js" asp-append-version="true" defer></script>
</div>
