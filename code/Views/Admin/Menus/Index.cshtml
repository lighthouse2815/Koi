@model AdminMenusViewModel
@{ ViewData["Title"] = "Quản lý thực đơn"; }
<div class="page-heading">
    <h1>Quản lý thực đơn</h1><button type="button" class="button" data-menu-create>+ Thêm thực đơn</button>
</div>
<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa thực đơn.</p></noscript>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Thực đơn</th>
                <th>Thứ tự</th>
                <th>Hiển thị</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in Model.Menus)
            {
                <tr>
                    <td><a href="@menu.File" target="_blank" rel="noopener">@menu.Label ↗</a></td>
                    <td>@menu.SortOrder</td>
                    <td>@(menu.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="link-button" data-menu-edit
                                    data-url="@Url.Action("Edit", new { id = menu.Id })"
                                    data-id="@menu.Id" data-revision="@menu.Revision" data-label="@menu.Label"
                                    data-sort-order="@menu.SortOrder" data-is-published="@menu.IsPublished.ToString().ToLowerInvariant()"
                                    data-image="@menu.File">Sửa</button>
                            <a asp-action="Delete" asp-route-id="@menu.Id" class="delete-link" data-name="@menu.Label">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Menus.Length == 0) { <p>Chưa có thực đơn.</p> }

<partial name="_DeleteDialog" />
<partial name="Edit" model="new MenuEditViewModel()" />
<script src="~/js/menu-editor.js" asp-append-version="true" defer></script>
