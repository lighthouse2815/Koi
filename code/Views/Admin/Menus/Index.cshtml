@model AdminMenusViewModel
@{ ViewData["Title"] = "Quản lý thực đơn"; }
<div class="page-heading">
    <h1>Quản lý thực đơn</h1><a asp-action="Create" class="button">+ Thêm thực đơn</a>
</div>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Thực đơn</th>
                <th>Thứ tự</th>
                <th>Hiển thị</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var menu in Model.Menus)
            {
                <tr>
                    <td><a href="@menu.File" target="_blank" rel="noopener">@menu.Label ↗</a></td>
                    <td>@menu.SortOrder</td>
                    <td>@(menu.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions"><a asp-action="Edit" asp-route-id="@menu.Id">Sửa</a><a asp-action="Delete" asp-route-id="@menu.Id" class="delete-link" data-name="@menu.Label">Xóa</a></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Menus.Length == 0) { <p>Chưa có thực đơn.</p> }

<partial name="_DeleteDialog" />
