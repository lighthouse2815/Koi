@model MenuEditViewModel

<dialog id="menu-editor" class="drink-editor" aria-labelledby="menu-editor-title">
    <div class="page-heading">
        <h2 id="menu-editor-title">Thêm thực đơn</h2>
        <button type="button" class="button secondary" data-menu-cancel>Đóng</button>
    </div>
    <form asp-action="Create" method="post" class="editor" data-upload-folder="menus" data-ajax-save
          data-create-url="@Url.Action("Create")">
        <fieldset class="upload-fields" disabled>
            <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="editor-columns">
                <div class="card">
                    <label asp-for="Label">Tên thực đơn</label><input asp-for="Label" required maxlength="200" />
                    <label for="ImageUpload">Ảnh thực đơn</label><input asp-for="ImageUploadId" type="hidden" /><input id="ImageUpload" type="file" accept="image/jpeg,image/png,image/webp" />
                    <p class="help">JPG, PNG hoặc WebP, tối đa 5 MB. Khi sửa, để trống để giữ ảnh hiện tại.</p>
                    <a data-menu-current target="_blank" rel="noopener" hidden><img class="current-image" alt="Thực đơn hiện tại" />Mở ảnh kích thước đầy đủ ↗</a>
                </div>
                <aside class="card">
                    <label asp-for="SortOrder">Thứ tự</label><input asp-for="SortOrder" type="number" min="0" max="100000" />
                    <p class="help">Số nhỏ hiển thị trước.</p><label class="check"><input asp-for="IsPublished" /> Hiển thị trên website</label>
                    <button class="button" type="submit">Lưu thực đơn</button>
                    <a asp-action="Index" data-menu-reload hidden>Tải lại bản mới nhất</a>
                </aside>
            </div>
        </fieldset>
    </form>
</dialog>
