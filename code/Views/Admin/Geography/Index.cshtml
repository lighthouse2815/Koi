@model GeographyIndexViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="page-heading">
    <h1>@Model.Title</h1><button type="button" class="button" data-geography-create>+ Thêm</button>
</div>
<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa khu vực.</p></noscript>
<p><a asp-route-kind="cities">Khu vực</a> · <a asp-controller="Stores">Chi nhánh</a></p>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Tên</th>
                <th>Thứ tự</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows) { <tr>
                    <td>@row.Name</td>
                    <td>@row.SortOrder</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="link-button" data-geography-edit
                                    data-url="@Url.Action("Edit", new { id = row.Id })"
                                    data-id="@row.Id" data-revision="@row.Revision" data-name="@row.Name"
                                    data-sort-order="@row.SortOrder">Sửa</button>
                            <a asp-action="Delete" asp-route-id="@row.Id" class="delete-link" data-name="@row.Name" asp-route-kind="@Model.Kind">Xóa</a>
                        </div>
                    </td>
                </tr> }
        </tbody>
    </table>
</div>
@if (Model.Rows.Length == 0) { <p>Chưa có dữ liệu.</p> }

<partial name="_DeleteDialog" />
<partial name="Edit" model="new GeographyEditViewModel { Kind = Model.Kind }" />
<script src="~/js/geography-editor.js" asp-append-version="true" defer></script>
