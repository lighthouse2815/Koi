@model GeographyEditViewModel

<dialog id="geography-editor" class="drink-editor" aria-labelledby="geography-editor-title">
    <div class="page-heading">
        <h2 id="geography-editor-title">Thêm khu vực</h2>
        <button type="button" class="button secondary" data-geography-cancel>Đóng</button>
    </div>
    <form asp-action="Create" method="post" class="editor" data-ajax-save data-create-url="@Url.Action("Create")">
        <fieldset class="upload-fields" disabled>
            <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" /><input asp-for="Kind" type="hidden" />
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="card">
                <label asp-for="Name">Tên</label><input asp-for="Name" required maxlength="150" />
                <label asp-for="SortOrder">Thứ tự</label><input asp-for="SortOrder" type="number" min="0" max="100000" />
                <p><button type="submit" class="button">Lưu dữ liệu</button></p>
                <a asp-action="Index" asp-route-kind="@Model.Kind" data-geography-reload hidden>Tải lại bản mới nhất</a>
            </div>
        </fieldset>
    </form>
</dialog>
