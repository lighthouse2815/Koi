@model AdminNewsViewModel
@{
    ViewData["Title"] = "Quản lý tin tức";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">NỘI DUNG WEBSITE</p>
        <h1>Quản lý tin tức</h1>
    </div><button type="button" class="button" data-news-create>+ Thêm bài viết</button>
</div>
<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa bài viết.</p></noscript>
<form method="get" class="search"><label for="search">Tìm theo tiêu đề</label>
    <div><input id="search" name="search" value="@Model.Search" maxlength="200" /><button type="submit" class="button secondary">Tìm kiếm</button></div>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>Danh mục</th>
                <th>Ngày đăng</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model.Articles)
            {
                <tr>
                    <td>
                        <div class="article-cell"><img src="@article.Image" alt="" loading="lazy" />
                            <div><strong>@article.Title</strong>@if (article.IsFeatured) { <span class="badge">Nổi bật</span> }@if (article.ShowOnHome) { <span class="badge">Trang chủ</span> }</div>
                        </div>
                    </td>
                    <td>@article.Category</td>
                    <td>@article.Date.ToString("dd/MM/yyyy")</td>
                    <td>@(article.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="link-button" data-news-edit
                                    data-url="@Url.Action("Edit", new { id = article.Id })"
                                    data-id="@article.Id" data-revision="@article.Revision" data-title="@article.Title"
                                    data-category="@article.Category" data-date="@article.Date.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)"
                                    data-body-html="@article.BodyHtml" data-image="@article.Image"
                                    data-video-url="@(article.VideoId == null ? "" : $"https://www.youtube.com/embed/{article.VideoId}")"
                                    data-is-published="@article.IsPublished.ToString().ToLowerInvariant()"
                                    data-is-featured="@article.IsFeatured.ToString().ToLowerInvariant()"
                                    data-show-on-home="@article.ShowOnHome.ToString().ToLowerInvariant()"
                                    data-home-order="@article.HomeOrder">Sửa</button>
                            <a asp-action="Preview" asp-route-id="@article.Id" target="_blank" rel="noopener">Xem trước</a>
                            <a asp-action="Delete" asp-route-id="@article.Id" class="delete-link" data-name="@article.Title">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Articles.Count == 0)
{
    <p>Không tìm thấy bài viết.</p>
}
<nav class="pagination" aria-label="Phân trang">
    @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">← Trước</a> }
    <span>Trang @Model.Page / @Model.PageCount</span>
    @if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Sau →</a> }
</nav>

<partial name="_DeleteDialog" />
<partial name="Edit" model="new NewsEditViewModel()" />
<script src="~/js/news-editor.js" asp-append-version="true" defer></script>
