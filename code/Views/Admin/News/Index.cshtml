@model AdminNewsViewModel
@{
    ViewData["Title"] = "Quản lý tin tức";
}
<div class="page-heading">
    <div>
        <p class="eyebrow">NỘI DUNG WEBSITE</p>
        <h1>Quản lý tin tức</h1>
    </div><a asp-action="Create" class="button">+ Thêm bài viết</a>
</div>
<form method="get" class="search"><label for="search">Tìm theo tiêu đề</label>
    <div><input id="search" name="search" value="@Model.Search" maxlength="200" /><button type="submit" class="button secondary">Tìm kiếm</button></div>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>Danh mục</th>
                <th>Ngày đăng</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var article in Model.Articles)
            {
                <tr>
                    <td>
                        <div class="article-cell"><img src="@article.Image" alt="" loading="lazy" />
                            <div><strong>@article.Title</strong>@if (article.IsFeatured) { <span class="badge">Nổi bật</span> }@if (article.ShowOnHome) { <span class="badge">Trang chủ</span> }</div>
                        </div>
                    </td>
                    <td>@article.Category</td>
                    <td>@article.Date.ToString("dd/MM/yyyy")</td>
                    <td>@(article.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions"><a asp-action="Edit" asp-route-id="@article.Id">Sửa</a><a asp-action="Preview" asp-route-id="@article.Id" target="_blank" rel="noopener">Xem trước</a><a asp-action="Delete" asp-route-id="@article.Id">Xóa</a></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Articles.Count == 0)
{
    <p>Không tìm thấy bài viết.</p>
}
<nav class="pagination" aria-label="Phân trang">
    @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">← Trước</a> }
    <span>Trang @Model.Page / @Model.PageCount</span>
    @if (Model.Page < Model.PageCount) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Sau →</a> }
</nav>
