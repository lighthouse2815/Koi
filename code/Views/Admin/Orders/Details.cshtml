@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<div class="page-heading"><h1>Chi tiết đơn hàng</h1><a asp-action="Index">← Danh sách đơn</a></div>
<section class="card"><p><strong>Mã đơn:</strong> @Model.Id</p><p><strong>Thời gian (UTC):</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p><p><strong>Chi nhánh:</strong> @Model.StoreName · @Model.StoreAddress</p><p><strong>Khách hàng:</strong> @Model.CustomerName · @Model.CustomerPhone</p><p><strong>Nhận hàng:</strong> @(Model.Fulfillment == FulfillmentMethod.Pickup ? "Nhận tại chi nhánh" : "Giao hàng")</p>@if (Model.Fulfillment == FulfillmentMethod.Delivery) { <p><strong>Địa chỉ giao:</strong> @Model.DeliveryAddress</p> }<p><strong>Ghi chú:</strong> @Model.Note</p><p><strong>Thanh toán:</strong> Khi nhận hàng; phí giao hàng được xác nhận riêng.</p>
<table><thead><tr><th>Đồ uống</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.DrinkName</td><td>@item.UnitPrice.ToString("N0", culture) đ</td><td>@item.Quantity</td><td>@((item.UnitPrice * item.Quantity).ToString("N0", culture)) đ</td></tr> }</tbody></table><p><strong>Tổng tiền món: @Model.Items.Sum(value => value.UnitPrice * value.Quantity).ToString("N0", culture) đ</strong></p>
<p><strong>Trạng thái:</strong> @(Model.Status switch { OrderStatus.New => "Mới", OrderStatus.Preparing => "Đang chuẩn bị", OrderStatus.Completed => "Hoàn thành", _ => "Đã hủy" })</p>
@if (Model.Status == OrderStatus.New || Model.Status == OrderStatus.Preparing) { <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post"><input type="hidden" name="current" value="@((int)Model.Status)" /><button type="submit" name="next" value="@((int)(Model.Status == OrderStatus.New ? OrderStatus.Preparing : OrderStatus.Completed))">@(Model.Status == OrderStatus.New ? "Bắt đầu chuẩn bị" : "Hoàn thành")</button> <button type="submit" name="next" value="@((int)OrderStatus.Cancelled)">Hủy đơn</button></form> }
</section>
