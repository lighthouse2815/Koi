@model AdminStoresViewModel
@{ ViewData["Title"] = "Quản lý chi nhánh"; }
<div class="page-heading">
    <h1>Quản lý chi nhánh</h1><button type="button" class="button" data-store-create>+ Thêm chi nhánh</button>
</div>
<noscript><p class="validation">Vui lòng bật JavaScript để thêm, sửa hoặc xóa chi nhánh.</p></noscript>
<p><a asp-controller="Geography" asp-route-kind="cities">Quản lý khu vực</a></p>
<form method="get" class="search"><label for="search">Tên hoặc địa chỉ</label><input id="search" name="search" value="@Model.Search" maxlength="200" />
    <p><button class="button secondary">Tìm kiếm</button></p>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Chi nhánh</th>
                <th>Khu vực</th>
                <th>Hiển thị</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var store in Model.Stores)
            {
                <tr>
                    <td><strong>@store.Name</strong><br />@store.Address</td>
                    <td>@(store.City?.Name ?? "Việt Nam")</td>
                    <td>@(store.IsPublished ? "Đã xuất bản" : "Bản nháp")</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="link-button" data-store-edit
                                    data-url="@Url.Action("Edit", new { id = store.Id })"
                                    data-id="@store.Id" data-revision="@store.Revision" data-name="@store.Name"
                                    data-city-id="@store.CityId" data-address="@store.Address" data-phone="@store.Phone"
                                    data-hours="@store.Hours" data-navigation-url="@store.NavigationUrl"
                                    data-sort-order="@store.SortOrder" data-is-published="@store.IsPublished.ToString().ToLowerInvariant()"
                                    data-image="@store.Photo">Sửa</button>
                            <a asp-action="Delete" asp-route-id="@store.Id" class="delete-link" data-name="@store.Name">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (Model.Stores.Length == 0) { <p>Không tìm thấy chi nhánh.</p> }
<nav class="pagination" aria-label="Phân trang">
    @if (Model.Page > 1) { <a asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">← Trước</a> }
    <span>Trang @Model.Page / @Model.PageCount</span>
    @if (Model.Page < Model.PageCount) { <a asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Sau →</a> }
</nav>

<partial name="_DeleteDialog" />
<partial name="Edit" model="new StoreEditViewModel { Cities = Model.Cities }" />
<script src="~/js/store-editor.js" asp-append-version="true" defer></script>
