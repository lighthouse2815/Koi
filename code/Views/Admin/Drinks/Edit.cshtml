@model DrinkEditViewModel

<dialog id="drink-editor" class="drink-editor" aria-labelledby="drink-editor-title">
    <div class="page-heading">
        <h2 id="drink-editor-title">Thêm đồ uống</h2>
        <button type="button" class="button secondary" data-drink-cancel>Đóng</button>
    </div>
    <form asp-action="Create" method="post" class="editor" data-upload-folder="drinks" data-ajax-save
          data-create-url="@Url.Action("Create")">
        <fieldset class="upload-fields" disabled>
            <input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" />
            <div asp-validation-summary="All" class="validation" role="alert"></div>
            <div class="editor-columns">
                <div class="card">
                    <label asp-for="Name">Tên đồ uống</label><input asp-for="Name" maxlength="250" required />
                    <label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" asp-items="Model.Categories" required>
                        <option value="">Chọn danh mục</option>
                    </select>
                    <label asp-for="Description">Mô tả</label><textarea asp-for="Description" rows="7" maxlength="4000"></textarea>
                </div>
                <aside class="card">
                    <label for="ImageUpload">Ảnh đồ uống</label><img class="current-image" alt="Ảnh hiện tại" hidden />
                    <input asp-for="ImageUploadId" type="hidden" /><input id="ImageUpload" type="file" accept="image/jpeg,image/png,image/webp" />
                    <p class="help">JPG, PNG hoặc WebP, tối đa 5 MB. Không có ảnh riêng sẽ dùng ảnh chung của danh mục.</p>
                    <label class="check"><input asp-for="RemoveImage" /> Bỏ ảnh riêng</label><label class="check"><input asp-for="IsPublished" /> Hiển thị trên website</label>
                    <label asp-for="SortOrder">Thứ tự trong danh mục</label><input asp-for="SortOrder" type="number" min="0" max="100000" />
                    <p class="help">Số nhỏ hiển thị trước.</p>
                    <button class="button" type="submit">Lưu đồ uống</button>
                    <a asp-action="Index" data-drink-reload hidden>Tải lại bản mới nhất</a>
                </aside>
            </div>
        </fieldset>
    </form>
</dialog>
