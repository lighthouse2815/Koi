@model AdminDrinksViewModel
@{ ViewData["Title"] = "Quản lý đồ uống"; }

<div class="page-heading admin-page-heading">
    <div class="admin-heading-title"><span class="admin-heading-icon"><partial name="_AdminIcon" model='"cup"' /></span><h1>Quản lý đồ uống</h1></div>
    <button type="button" class="button" data-drink-create>
        <partial name="_AdminIcon" model='"plus"' /> Thêm đồ uống
    </button>
</div>

<noscript>
    <p class="validation">
        Vui lòng bật JavaScript để thêm hoặc sửa đồ uống.
    </p>
</noscript>

<form method="get" class="search">
    <div class="search-field">
        <label for="search">Tên đồ uống</label>
        <input id="search" name="search" value="@Model.Search" maxlength="200" />
    </div>
    <div class="search-field">
        <label for="categoryId">Danh mục</label>
        <select name="categoryId" id="categoryId" asp-items="Model.Categories">
            <option value="">Tất cả danh mục</option>
        </select>
    </div>
    <button type="submit" class="button secondary"><partial name="_AdminIcon" model='"search"' /> Tìm kiếm</button>
</form>

<div class="table-wrap" tabindex="0" role="region" aria-label="Danh sách đồ uống">
    <table>
        <thead>
            <tr>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"cup"' /> Đồ uống</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"layers"' /> Danh mục</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"order"' /> Thứ tự</span></th>
                <th scope="col"><span class="admin-column"><partial name="_AdminIcon" model='"settings"' /> Thao tác</span></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var drink in Model.Drinks)
            {
                var previewImage = string.IsNullOrEmpty(drink.Image) ? drink.Category.Image : drink.Image;
                <tr data-row-preview>
                    <td>
                        <div class="article-cell"><img src="@previewImage" alt="" loading="lazy" />
                            <div><strong>@drink.Name</strong></div>
                        </div>
                    </td>
                    <td>@drink.Category.Name</td>
                    <td>@drink.SortOrder</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" data-row-preview-trigger aria-label="Xem thông tin @drink.Name" hidden><partial name="_AdminIcon" model='"eye"' /> Xem</button>
                            <button type="button" class="link-button" data-drink-edit
                                    data-url="@Url.Action("Edit", new { id = drink.Id })"
                                    data-id="@drink.Id" data-revision="@drink.Revision" data-name="@drink.Name"
                                    data-category-id="@drink.CategoryId" data-description="@drink.Description"
                                    data-sort-order="@drink.SortOrder"
                                    data-image="@drink.Image"><partial name="_AdminIcon" model='"edit"' /> Sửa</button>
                            <a asp-action="Delete" asp-route-id="@drink.Id" class="delete-link" data-name="@drink.Name"><partial name="_AdminIcon" model='"trash"' /> Xóa</a>
                        </div>
                        <template data-row-preview-content data-title="@drink.Name">
                            <dl class="row-preview-details">
                                <div><dt>Danh mục</dt><dd>@drink.Category.Name</dd></div>
                                <div><dt>Thứ tự</dt><dd>@drink.SortOrder</dd></div>
                                <div class="row-preview-wide"><dt>Mô tả</dt><dd>@(string.IsNullOrWhiteSpace(drink.Description) ? "Chưa có mô tả" : drink.Description)</dd></div>
                                @if (!string.IsNullOrWhiteSpace(previewImage))
                                {
                                    <div class="row-preview-wide">
                                        <dt>@(string.IsNullOrEmpty(drink.Image) ? "Ảnh dùng chung của danh mục" : "Ảnh đồ uống")</dt>
                                        <dd><img class="row-preview-image" src="@previewImage" alt="" /></dd>
                                    </div>
                                }
                            </dl>
                        </template>
                    </td>
                </tr>
            }
            @if (Model.Drinks.Count == 0)
            {
                <tr><td colspan="4" class="empty-state">Không tìm thấy đồ uống.</td></tr>
            }
        </tbody>
    </table>
</div>

<nav class="pagination" aria-label="Phân trang">
    @if (Model.Page > 1)
    {
        <a
            asp-route-page="@(Model.Page - 1)"
            asp-route-categoryId="@Model.CategoryId"
            asp-route-search="@Model.Search"
        >
            ← Trước
        </a>
    }

    <span>Trang @Model.Page / @Model.PageCount</span>

    @if (Model.Page < Model.PageCount)
    {
        <a
            asp-route-page="@(Model.Page + 1)"
            asp-route-categoryId="@Model.CategoryId"
            asp-route-search="@Model.Search"
        >
            Sau →
        </a>
    }
</nav>

<partial name="_RowPreviewDialog" />
<partial name="_DeleteDialog" />
<partial
    name="Edit"
    model="new DrinkEditViewModel
    {
        Categories = Model.Categories,
        CategoryId = Model.CategoryId
    }"
/>

<script src="~/js/drink-editor.js" asp-append-version="true" defer></script>
