@model OrderingPageViewModel
@{
    Layout = "_OrderLayout";
    ViewData["Title"] = "Đặt hàng";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var itemCount = Model.Cart.Items.Sum(item => item.Quantity);
    ViewData["CartItemCount"] = itemCount;
    var hasSearch = !string.IsNullOrEmpty(Model.Search);
    var canCheckout = Model.Branch != null && Model.Lines.Count > 0;
    var catalogTitle = Model.FilterName ?? (Model.DrinkId.HasValue ? "Món bạn đã chọn" : hasSearch ? "Kết quả tìm kiếm" : "Tất cả đồ uống");
}

<a href="#cart" class="mobile-cart-link">
    <span>Giỏ hàng · @itemCount món</span>
    <strong>@Model.Total.ToString("N0", culture) đ <span aria-hidden="true">↗</span></strong>
</a>

<div class="order-shell">
    <section class="order-hero" aria-labelledby="order-title">
        <div class="order-hero-copy">
            <h1 id="order-title">
                <span class="order-title-line"><span>Hôm nay,</span></span>
                <span class="order-title-line"><em>bạn uống gì?</em></span>
            </h1>
            <p>Trà pha mới, vị KOI bạn yêu thích.</p>
            <a class="order-explore" href="#drinks">Khám phá thực đơn <span class="order-arrow" aria-hidden="true">↓</span></a>
        </div>
        <div class="order-hero-art" aria-hidden="true">
            <div class="order-hero-orbit"></div>
            <span class="order-hero-spark">✳</span>
            <div class="order-hero-drink"><img src="~/images/drink-milk-tea.png" width="561" height="786" alt="" fetchpriority="high" /></div>
        </div>
    </section>

    <details class="branch-picker" id="branches" open="@(Model.Branch == null)">
        <summary>
            <span class="order-arrow branch-symbol" aria-hidden="true">↗</span>
            <span class="branch-summary">
                <small>Chi nhánh của bạn</small>
                <strong>@(Model.Branch?.Name ?? "Chọn chi nhánh nhận đơn")</strong>
                @if (Model.Branch != null)
                {
                    <span class="branch-address">@Model.Branch.Address</span>
                }
            </span>
            <span class="branch-change">@(Model.Branch == null ? "Danh sách" : "Thay đổi") <span aria-hidden="true">↓</span></span>
        </summary>
        <div class="branch-picker-content">
            @if (Model.Branches.Length == 0)
            {
                <p>Hiện chưa có chi nhánh mở nhận đơn.</p>
            }
            else
            {
                <form asp-action="SelectBranch" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                      asp-route-search="@Model.Search" method="post" class="inline-form">
                    <label class="visually-hidden" for="storeId">Chi nhánh nhận đơn</label>
                    <select id="storeId" name="storeId" required>
                        <option value="">Chọn chi nhánh</option>
                        @foreach (var branch in Model.Branches)
                        {
                            <option value="@branch.Id" selected="@(branch.Id == Model.Cart.StoreId)">@branch.Name · @branch.Address</option>
                        }
                    </select>
                    <button class="order-button" type="submit">Xác nhận <span aria-hidden="true">↗</span></button>
                </form>
            }
        </div>
    </details>

    <div id="drinks">
        @if (TempData["OrderMessage"] is string message)
        {
            <p class="order-notice" role="status">@message <a href="#cart">Xem giỏ hàng <span aria-hidden="true">↗</span></a></p>
        }
        @if (!canCheckout && !ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="order-notice" role="alert" tabindex="-1" autofocus></div>
        }
        <div class="order-workspace">
            <section class="order-catalog" aria-labelledby="menu-title">
                <div class="order-section-heading">
                    <div>
                        <h2 id="menu-title">@catalogTitle</h2>
                        <p class="menu-result-count">@Model.DrinkCount món</p>
                    </div>
                    <form asp-action="Index" asp-fragment="drinks" method="get" class="menu-search" role="search">
                        @if (Model.CategoryId.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@Model.CategoryId" />
                        }
                        <label class="visually-hidden" for="drink-search">Tìm đồ uống theo tên</label>
                        <input type="search" id="drink-search" name="search" value="@Model.Search" placeholder="Tìm đồ uống theo tên" maxlength="200" />
                        <button type="submit" class="order-button">Tìm kiếm</button>
                    </form>
                </div>
                <nav class="order-category-nav" aria-label="Danh mục đồ uống">
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-fragment="drinks" aria-current="@(!Model.CategoryId.HasValue && !Model.DrinkId.HasValue ? "page" : null)"><span aria-hidden="true">✳</span> Tất cả</a>
                    @foreach (var category in Model.Categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@category.Id" asp-route-search="@Model.Search" asp-fragment="drinks" aria-current="@(category.Id == Model.CategoryId ? "page" : null)">
                            @if (!string.IsNullOrWhiteSpace(category.Icon))
                            {
                                <img src="@category.Icon" width="19" height="19" alt="" />
                            }
                            @category.Name
                        </a>
                    }
                </nav>
                @if (Model.DrinkId.HasValue || Model.CategoryId.HasValue || hasSearch)
                {
                    <a class="order-reset" asp-action="Index" asp-fragment="drinks">Xem toàn bộ thực đơn <span aria-hidden="true">↗</span></a>
                }
                <div class="drink-results" data-menu-results>
                    <div class="drink-grid">
                        @foreach (var drink in Model.Drinks)
                        {
                            var name = drink.Name;
                            var hasImage = !string.IsNullOrWhiteSpace(drink.Image);
                            <article class="order-drink-card" data-drink-id="@drink.Id">
                                <div class="drink-visual">
                                    <img class="order-drink-image" src="@(hasImage ? drink.Image : drink.Category.Image)" alt="@name" loading="lazy" />
                                    @if (!hasImage)
                                    {
                                        <small>Ảnh danh mục</small>
                                    }
                                </div>
                                <div class="drink-card-content">
                                    <p class="drink-category-label">@drink.Category.Name</p>
                                    <h3>@name</h3>
                                    <div class="drink-buy-row">
                                        <p class="drink-price">@(drink.Price > 0 ? drink.Price.Value.ToString("N0", culture) + " đ" : "Chưa mở bán")</p>
                                        @if (drink.Price > 0 && Model.Branch == null)
                                        {
                                            <a class="drink-branch-link" asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@drink.Id"
                                               asp-route-search="@Model.Search" asp-fragment="branches" aria-label="Chọn món @name">Chọn món <span class="order-arrow" aria-hidden="true">+</span></a>
                                        }
                                    </div>
                                    @if (drink.Price > 0 && Model.Branch != null)
                                    {
                                        <details class="drink-customize" open="@(Model.DrinkId == drink.Id)">
                                            <summary aria-label="Chọn món @name">Chọn món <span class="order-arrow" aria-hidden="true">+</span></summary>
                                            <form asp-action="Add" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                                                  asp-route-search="@Model.Search" method="post">
                                                <input type="hidden" name="id" value="@drink.Id" />
                                                <label class="quantity-option">Số lượng <input type="number" name="quantity" min="1" max="20" value="1" /></label>
                                                <button class="order-button" type="submit">Thêm vào giỏ <span aria-hidden="true">↗</span></button>
                                            </form>
                                        </details>
                                    }
                                </div>
                            </article>
                        }
                        @if (Model.Drinks.Length == 0)
                        {
                            <div class="menu-empty">
                                <p>@(hasSearch ? "Không tìm thấy đồ uống phù hợp." : "Chưa có đồ uống trong danh mục này.")</p>
                            </div>
                        }
                    </div>
                    @if (Model.DrinkCount > 0)
                    {
                        <div class="menu-scroll" data-menu-scroll>
                            <p class="menu-load-status" role="status">@(Model.HasMoreDrinks ? "Cuộn xuống để khám phá thêm món." : "Bạn đã xem hết đồ uống rồi.")</p>
                            @if (Model.HasMoreDrinks)
                            {
                                <a class="menu-load-more order-explore" asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                                   asp-route-search="@Model.Search" asp-route-page="@(Model.Page + 1)" asp-fragment="drinks" rel="next">Xem thêm đồ uống <span class="order-arrow" aria-hidden="true">↓</span></a>
                            }
                        </div>
                    }
                </div>
            </section>

            <aside class="order-sidebar" aria-labelledby="cart-title">
                <section class="order-cart" id="cart" tabindex="-1">
                    <div class="cart-heading">
                        <h2 id="cart-title">Món của bạn</h2>
                        <span class="cart-count" aria-label="@itemCount món">@itemCount</span>
                    </div>
                    @if (Model.Lines.Count == 0)
                    {
                        <div class="empty-cart">
                            <img src="~/images/bear-head.svg" width="84" height="84" alt="" />
                            <p>Giỏ hàng còn trống.</p>
                        </div>
                    }
                    else
                    {
                        <div class="cart-lines">
                            @foreach (var line in Model.Lines)
                            {
                                <div class="cart-line">
                                    <div class="cart-line-title"><strong>@line.Name</strong><span>@((line.Price * line.Quantity).ToString("N0", culture)) đ</span></div>
                                    <div class="cart-line-actions">
                                        <form asp-action="Update" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                                              asp-route-search="@Model.Search" method="post" class="cart-update">
                                            <input type="hidden" name="id" value="@line.LineId" />
                                            <label>Số lượng <input type="number" name="quantity" min="0" max="20" value="@line.Quantity" /></label>
                                            <button class="order-button" type="submit">Lưu</button>
                                        </form>
                                        <form asp-action="Update" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                                              asp-route-search="@Model.Search" method="post">
                                            <input type="hidden" name="id" value="@line.LineId" />
                                            <input type="hidden" name="quantity" value="0" />
                                            <button type="submit" class="cart-remove" aria-label="Xóa món @line.Name">Xóa</button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    <div class="cart-total"><span>Tạm tính</span><strong>@Model.Total.ToString("N0", culture) đ</strong></div>
                    <p class="cart-payment-note">Thanh toán khi nhận hàng.<br />Chi nhánh sẽ xác nhận phí giao hàng.</p>
                    @if (canCheckout)
                    {
                        <a href="#checkout" class="checkout-link order-button">Thông tin nhận hàng <span aria-hidden="true">↓</span></a>
                    }
                    else if (Model.Branch == null)
                    {
                        <a href="#branches" class="checkout-link order-button">Chọn chi nhánh <span aria-hidden="true">↗</span></a>
                    }
                </section>

                @if (canCheckout)
                {
                    <section class="checkout-panel" id="checkout" tabindex="-1">
                        <h2>Thông tin nhận hàng</h2>
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="All" class="order-notice" role="alert" tabindex="-1" autofocus></div>
                        }
                        <form asp-action="Checkout" asp-route-categoryId="@Model.CategoryId" asp-route-drinkId="@Model.DrinkId"
                              asp-route-search="@Model.Search" method="post" class="checkout-form">
                            <label asp-for="Checkout.CustomerName">Họ tên</label>
                            <input asp-for="Checkout.CustomerName" required maxlength="150" autocomplete="name" />
                            <span asp-validation-for="Checkout.CustomerName"></span>
                            <label asp-for="Checkout.CustomerPhone">Số điện thoại</label>
                            <input asp-for="Checkout.CustomerPhone" type="tel" required maxlength="30" autocomplete="tel" />
                            <span asp-validation-for="Checkout.CustomerPhone"></span>
                            <label asp-for="Checkout.Fulfillment">Cách nhận hàng</label>
                            <select asp-for="Checkout.Fulfillment">
                                <option value="0">Nhận tại chi nhánh</option>
                                <option value="1">Giao hàng</option>
                            </select>
                            <label asp-for="Checkout.DeliveryAddress">Địa chỉ giao hàng</label>
                            <input asp-for="Checkout.DeliveryAddress" maxlength="2000" autocomplete="street-address" />
                            <span asp-validation-for="Checkout.DeliveryAddress"></span>
                            <small>Bắt buộc nếu chọn giao hàng.</small>
                            <label asp-for="Checkout.Note">Ghi chú</label>
                            <textarea asp-for="Checkout.Note" maxlength="1000"></textarea>
                            <button class="order-button" type="submit">Gửi đơn hàng <span aria-hidden="true">↗</span></button>
                        </form>
                    </section>
                }
            </aside>
        </div>
    </div>
</div>
