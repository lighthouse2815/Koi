@model string
@{
    Layout = "_OrderLayout";
    ViewData["Title"] = "Đã gửi đơn";
}

<div class="order-shell">
    <section class="order-confirmation" aria-labelledby="order-confirmation-title">
        <span class="order-confirmation-mark" aria-hidden="true">✓</span>
        <h1 class="order-title-line" id="order-confirmation-title"><span>Đã gửi đơn hàng</span></h1>
        <p>Chi nhánh sẽ liên hệ để xác nhận đơn và thông tin nhận hàng.</p>
        <p class="order-reference">Mã đơn <strong>@Model</strong></p>
        <div class="order-confirmation-actions">
            <a class="order-button" asp-action="History">Xem đơn đã mua <span aria-hidden="true">↗</span></a>
            <a class="order-explore" asp-action="Index">Đặt đơn khác <span class="order-arrow" aria-hidden="true">↗</span></a>
        </div>
    </section>
</div>
