@model string
@{ Layout = null; }
<!doctype html><html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Đã gửi đơn · KOI Thé</title><link rel="stylesheet" href="~/css/ordering.css" asp-append-version="true" /></head><body>
<header class="order-header"><a asp-controller="Home" asp-action="Index"><img src="~/images/logo.svg" width="184" height="39" alt="KOI Thé" /></a><a asp-controller="Home" asp-action="OurTea">Trà của KOI ↗</a></header>
