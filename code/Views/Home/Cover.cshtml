@{
    Layout = "_CoverLayout";
}
<main class="language-cover" aria-label="Chọn ngôn ngữ / Choose your language">
    <img class="cover-logo" src="~/images/cover-logo.svg" width="209.8" height="44.14" alt="KOI Thé" />
    <nav class="cover-languages" aria-label="Ngôn ngữ / Language">
        <form asp-controller="Home" asp-action="Language" method="post"><input type="hidden" name="culture" value="vi" /><button class="cover-vietnamese" type="submit" lang="vi">TIẾNG VIỆT</button></form>
        <form asp-controller="Home" asp-action="Language" method="post"><input type="hidden" name="culture" value="en" /><button class="cover-english" type="submit" lang="en">ENGLISH</button></form>
    </nav>
</main>
