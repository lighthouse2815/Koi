          </g>
          <g class="arrow">
           <rect class="d" x="5.63" y="21.23" width="48.52" height="4.68"></rect>
           <path class="d" d="M37.65,1.08c.7,1.09,.37,2.54-.72,3.23L6.7,23.57l30.23,19.25c1.09,.7,1.42,2.15,.72,3.23s-2.15,1.4-3.24,.72L1.08,25.55c-.67-.43-1.08-1.18-1.08-1.98s.41-1.55,1.08-1.98L34.41,.37c.39-.25,.83-.37,1.26-.37,.77,0,1.53,.38,1.98,1.08Z"></path>
          </g>
         </g>
        </g>
       </svg><img class="hide-for-large" src="/images/pages/en/images/news-back-mobile.svg" alt="" loading="lazy">
      </div></a>
     <div class="share-area"><button type="button" class="article-share" data-copy-link="">@T["Copy link ↗"]</button><span role="status" class="share-status"></span></div>
    </div>
    </div>
</div>
</div>
@section Scripts {
    <script src="~/js/content-pages.js" asp-append-version="true" defer></script>
}
