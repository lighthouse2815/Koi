        @if (Model.Featured.Length > 0)
        {
        <div class="new-drinkWrap flex-container align-center">
            <div class="tea-new-background swiper" aria-hidden="true"><div class="swiper-wrapper">
                @foreach (var item in Model.Featured) { <div class="swiper-slide"><img src="@item.BackgroundImage" alt="" /></div> }
            </div></div>
            <div class="tea-feature-content">
                <div class="title"><div class="en">@T["NEW DRINKS"]</div></div>
                <div class="pic tea-new-pictures swiper"><ul class="swiper-wrapper">
                    @foreach (var item in Model.Featured) { <li class="swiper-slide"><img src="@item.Image" alt="" /></li> }
                </ul></div>
                <div class="tea-new-copy swiper"><ul class="new-drink">
                    @for (var index = 0; index < Model.Featured.Length; index++)
                    {
                        var item = Model.Featured[index];
                        <li data-drink="@(index + 1)"><div class="inner">@if (!string.IsNullOrEmpty(item.Region)) { <div class="region">/ @SiteText.Select(item.Region, item.RegionVi)</div> }<div class="en">@SiteText.Select(item.Name, item.NameVi)</div></div></li>
                    }
                </ul><div class="tea-new-pagination"></div></div>
            </div>
            <button type="button" class="tea-pause" aria-pressed="false">@T["( Pause motion )"]</button>
        </div>
        }
        <section class="tea-catalog" id="tea-menu" aria-labelledby="tea-catalog-title">
            <header class="tea-catalog-heading">
                <div><p class="tea-eyebrow">KOI THÉ · MENU</p><h2 id="tea-catalog-title">@(SiteText.IsVietnamese ? "Chọn món bạn yêu thích" : "Find your favourite")</h2><p>@(SiteText.IsVietnamese ? "Một chút trà, một chút niềm vui mỗi ngày." : "A little tea, a little joy for your day.")</p></div>
                <a class="tea-all-menu" asp-controller="Order" asp-action="Index" asp-fragment="drinks">@(SiteText.IsVietnamese ? "Xem toàn bộ thực đơn" : "Explore the full menu") <span aria-hidden="true">↗</span></a>
            </header>
            <nav class="tea-category-nav" aria-label="@(SiteText.IsVietnamese ? "Danh mục đồ uống" : "Drink categories")">
                @foreach (var category in Model.Categories) { <a href="#@category.Id">@SiteText.Select(category.Name, category.NameVi)</a> }
            </nav>
            <ul class="drinkWrapList tea-categories">
                @foreach (var category in Model.Categories)
                {
                    <li id="@category.Id" class="tea-category">
                        <div class="tea-category-heading"><div class="title"><span class="tea-category-number">KOI THÉ /</span><h3 class="en">@SiteText.Select(category.Name, category.NameVi)</h3></div>
                            <a class="tea-view-all" asp-controller="Order" asp-action="Index" asp-route-categoryId="@category.Id" asp-fragment="drinks">@(SiteText.IsVietnamese ? "Xem tất cả sản phẩm" : "View all drinks") <span aria-hidden="true">↗</span></a>
                        </div>
                        <ul class="drinkList tea-products">
                            @foreach (var drink in category.Drinks.Take(4))
                            {
                                var name = SiteText.Select(drink.Name, drink.NameVi);
                                var hasImage = !string.IsNullOrWhiteSpace(drink.Image);
                                <li class="tea-product" data-drink-id="@drink.Id">
                                    <div class="tea-product-image"><img src="@(hasImage ? drink.Image : category.Image)" alt="@name" loading="lazy" />@if (!hasImage) { <span>@(SiteText.IsVietnamese ? "Ảnh danh mục" : "Category image")</span> }</div>
                                    <div class="tea-product-details"><div class="en">@name</div><div class="content">@SiteText.Select(drink.Description, drink.DescriptionVi)</div>
                                        @if (drink.Price > 0) { <div class="tea-product-bottom"><strong>@drink.Price.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) đ</strong><a asp-controller="Order" asp-action="Index" asp-route-drinkId="@drink.Id" asp-fragment="drinks" aria-label="@(SiteText.IsVietnamese ? "Chọn " : "Choose ")@name">@(SiteText.IsVietnamese ? "Chọn món" : "Choose") <span aria-hidden="true">↗</span></a></div> }
                                        else { <p class="tea-unavailable">@(SiteText.IsVietnamese ? "Chưa mở bán" : "Not available")</p> }
                                    </div>
                                </li>
                            }
                        </ul>
                        @if (category.Drinks.Count == 0) { <p>@(SiteText.IsVietnamese ? "Chưa có sản phẩm." : "No drinks yet.")</p> }
                    </li>
                }
            </ul>
        </section>
    </div>
</div>
@section VendorScripts {
    <script src="~/lib/swiper/swiper-bundle.min.js" defer></script>
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" defer></script>
    <script src="~/lib/gsap/ScrollToPlugin.min.js" defer></script>
}
@section Scripts {
    <script src="~/js/content-pages.js" asp-append-version="true" defer></script>
}
