@model MenuViewModel
@{
    ViewData["Title"] = T["Menu__text"].Value;

}
@section Styles {
    <script>
        if (!location.hash) {
            history.scrollRestoration = "manual";
            scrollTo({ top: 0, behavior: "instant" });
        }
    </script>
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <noscript><style>.menuListWrap .head-area .en, .menuListWrap .menuList { transform: none; opacity: 1; } .menuListWrap .head-area { --menu-rule-width: 100%; }</style></noscript>
}
<div class="content-page" id="home">
<div class="menuListWrap menu-pin">
    <div class="head-area"><h1 class="en">@T["MENU"]</h1></div>
    <ul class="menuList" aria-label="@T["Menus by country"]">
            <li class="menu-inner">
                <div class="inner flex-container align-justify">
                    <div class="title"><h2 class="en">@T["VIETNAM"]</h2></div>
                    <ul class="linkList">
                        @foreach (var menu in Model.Menus)
                        {
                            <li><a href="@menu.File" target="_blank" rel="noopener noreferrer" class="flex-container align-middle" aria-label="@T["VIETNAM"] – @menu.Label menu (opens in a new tab)">
                                <span class="store">@menu.Label</span>
                                <span class="arrow">
<svg class="show-for-large" xmlns="http://www.w3.org/2000/svg" width="34.68" height="30.19" viewBox="0 0 34.68 30.19" aria-hidden="true">
                                                <g>
                                                    <g>
                                                        <line class="e" y1="15.09" x2="31.07" y2="15.09"></line>
                                                        <path class="d" d="M10.57,29.49c-.45-.7-.24-1.63,.46-2.07L30.39,15.09,11.03,2.76c-.7-.45-.91-1.37-.46-2.07s1.38-.9,2.07-.46l21.34,13.59c.43,.28,.69,.75,.69,1.27s-.26,.99-.69,1.27L12.64,29.95c-.25,.16-.53,.23-.81,.23-.5,0-.98-.25-1.27-.69Z"></path>
                                                    </g>
                                                </g>
                                            </svg>
<svg class="hide-for-large" xmlns="http://www.w3.org/2000/svg" width="24.68" height="20.12" viewBox="0 0 24.68 20.12" aria-hidden="true">
                                                <g>
                                                    <g>
                                                        <line class="e" y1="10.06" x2="22.28" y2="10.06"></line>
                                                        <path class="d" d="M8.61,19.66c-.3-.46-.16-1.08,.31-1.38l12.9-8.22L8.92,1.84c-.47-.3-.61-.92-.31-1.38s.92-.6,1.38-.31l14.23,9.06c.29,.18,.46,.5,.46,.84s-.18,.66-.46,.84l-14.23,9.06c-.17,.11-.35,.16-.54,.16-.33,0-.65-.16-.85-.46Z"></path>
                                                    </g>
                                                </g>
                                            </svg>
                                </span>
                            </a></li>
                        }
                    </ul>
                </div>
            </li>
    </ul>
    <div class="back"><a asp-controller="Home" asp-action="OurTea" class="flex-container align-middle" aria-label="@T["Back to Our Tea"]">@if (SiteText.IsVietnamese) { <span class="localized-control-text"><span class="control-arrow" aria-hidden="true">←</span>@T["( Back )"]</span> }
<svg class="show-for-large" xmlns="http://www.w3.org/2000/svg" width="54.15" height="47.14" viewBox="0 0 54.15 47.14" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="21.22" width="48.52" height="4.68"></rect>
                            <path class="d" d="M16.5,46.05c-.7-1.09-.37-2.54,.72-3.23l30.23-19.25L17.22,4.31c-1.09-.7-1.42-2.15-.72-3.23s2.15-1.4,3.24-.72L53.07,21.59c.67,.43,1.08,1.18,1.08,1.98s-.41,1.55-1.08,1.98L19.74,46.77c-.39,.25-.83,.37-1.26,.37-.77,0-1.53-.38-1.98-1.08Z"></path>
                        </g>
                    </g>
                </svg>
<svg class="hide-for-large" xmlns="http://www.w3.org/2000/svg" width="38.68" height="33.67" viewBox="0 0 38.68 33.67" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="15.16" width="34.66" height="3.35"></rect>
                            <path class="d" d="M11.79,32.9c-.5-.78-.26-1.81,.52-2.31l21.59-13.75L12.3,3.08c-.78-.5-1.01-1.53-.52-2.31s1.54-1,2.31-.51l23.81,15.16c.48,.31,.77,.84,.77,1.41s-.29,1.1-.77,1.41l-23.81,15.16c-.28,.18-.59,.26-.9,.26-.55,0-1.09-.27-1.42-.77Z"></path>
                        </g>
                    </g>
                </svg>
        <span class="text">@T["OUR TEA"]</span>
    </a></div>
</div>
</div>
@section VendorScripts {
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" defer></script>
}
@section Scripts {
    <script src="~/js/content-pages.js" asp-append-version="true" defer></script>
}
