@model MenuViewModel
@{
    ViewData["Title"] = "Thực đơn";
}
@section Styles {
    <script>
        if (!location.hash) {
            history.scrollRestoration = "manual";
            scrollTo({ top: 0, behavior: "instant" });
        }
    </script>
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
}
<div class="content-page" id="home">
    <div class="menuListWrap">
        <div class="head-area">
            <h1 class="en">THỰC ĐƠN</h1>
        </div>
        <section class="menu-gallery" aria-labelledby="menu-country">
            <h2 class="en" id="menu-country">VIỆT NAM</h2>
            <ul class="menu-gallery__list">
                @foreach (var menu in Model.Menus)
                {
                    <li>
                        <a class="menu-gallery__photo" href="@menu.File" aria-label="Mở ảnh thực đơn @menu.Label" data-menu-photo>
                            <img src="@menu.File" alt="Thực đơn @menu.Label" />
                            <span>@menu.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
        <div class="back"><a asp-controller="Home" asp-action="OurTea" class="flex-container align-middle" aria-label="Quay lại Trà của KOI"><span class="localized-control-text"><span class="control-arrow" aria-hidden="true">←</span>( Quay lại )</span>
                <svg class="show-for-large" xmlns="http://www.w3.org/2000/svg" width="54.15" height="47.14" viewBox="0 0 54.15 47.14" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="21.22" width="48.52" height="4.68"></rect>
                            <path class="d" d="M16.5,46.05c-.7-1.09-.37-2.54,.72-3.23l30.23-19.25L17.22,4.31c-1.09-.7-1.42-2.15-.72-3.23s2.15-1.4,3.24-.72L53.07,21.59c.67,.43,1.08,1.18,1.08,1.98s-.41,1.55-1.08,1.98L19.74,46.77c-.39,.25-.83,.37-1.26,.37-.77,0-1.53-.38-1.98-1.08Z"></path>
                        </g>
                    </g>
                </svg>
                <svg class="hide-for-large" xmlns="http://www.w3.org/2000/svg" width="38.68" height="33.67" viewBox="0 0 38.68 33.67" aria-hidden="true">
                    <g>
                        <g>
                            <rect class="d" y="15.16" width="34.66" height="3.35"></rect>
                            <path class="d" d="M11.79,32.9c-.5-.78-.26-1.81,.52-2.31l21.59-13.75L12.3,3.08c-.78-.5-1.01-1.53-.52-2.31s1.54-1,2.31-.51l23.81,15.16c.48,.31,.77,.84,.77,1.41s-.29,1.1-.77,1.41l-23.81,15.16c-.28,.18-.59,.26-.9,.26-.55,0-1.09-.27-1.42-.77Z"></path>
                        </g>
                    </g>
                </svg>
                <span class="text">TRÀ CỦA KOI</span>
            </a></div>
    </div>
</div>
@if (Model.Menus.Count > 0)
{
    <dialog class="menu-viewer" id="menu-viewer" aria-labelledby="menu-viewer-title">
        <div class="menu-viewer__toolbar">
            <h2 id="menu-viewer-title">Ảnh thực đơn</h2>
            <div class="menu-viewer__controls">
                <button type="button" data-zoom-out aria-label="Thu nhỏ" disabled>−</button>
                <output>100%</output>
                <button type="button" data-zoom-in aria-label="Phóng to">+</button>
                <form method="dialog">
                    <button autofocus>Đóng</button>
                </form>
            </div>
        </div>
        <div class="menu-viewer__viewport" tabindex="0" role="region" aria-label="Vùng cuộn ảnh thực đơn">
            <img class="menu-viewer__image" alt="" />
        </div>
    </dialog>
}
@section VendorScripts {
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" defer></script>
}
@section Scripts {
    <script src="~/js/content-pages.js" asp-append-version="true" defer></script>
    <script src="~/js/menu-viewer.js" asp-append-version="true" defer></script>
}
