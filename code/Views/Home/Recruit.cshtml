@{
    ViewData["Title"] = T["Recruit__text"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/css/recruit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
}
<div class="content-page" id="home">
    <div class="recruitWrap menu-pin">
        <h1 class="visually-hidden">@T["Careers at KOI Thé"]</h1>
        <div class="recruit-top">
            <div class="head-area">
                <div class="head-1">
                    <div class="en top show-for-large">@T["We Want"]</div>
                    <div class="en top hide-for-large">@T["We"]</div>
                </div>
                <div class="head-1-2 hide-for-large">
                    <div class="en">@T["Want"]</div>
                </div>
                <div class="head-2">
                    <div class="en bottom">
                        <div class="note show-for-large">@T["RECRUIT"]</div>
                        @T["YOU!"]
                    </div>
                </div>
                <div class="note hide-for-large">@T["RECRUIT"]</div>
                <div class="bear show-for-large"><img src="/images/pages/en/images/recruit-bear.svg" alt=""></div>
            </div>
            <div class="recruitList">
                <div class="title">
                    @T["Clear Promotion Pathway"] <br>@T["Transparent Pay Progression"]
                </div>
                <div class="article-area">
                    <div class="top flex-container">
                        <div>@T["Operations"]<br>@T["Management"] <br class="hide-for-large">@T["Type"]</div>
                        <div>@T["Job Title"]</div>
                        <div class="two medium-short uk mobile-little">@T["USA/"]<br class="hide-for-large">@T["Europe/UK"]<br>@T["Base Salary"] <span class="little">@T["(USD)"]</span></div>
                        <div class="two medium-short mobile-little">@T["Asia-Pac"]<br>@T["Base Salary"] <span class="little">@T["(USD)"]</span></div>
                    </div>
                    <div class="content flex-container">
                        <div class="name">@T["Managing"] <br>@T["Single Store"]</div>
                        <div>@T["Store Manager"]</div>
                        <div class="medium-short">3,000</div>
                        <div class="medium-short">1,872</div>
                    </div>
                    <div class="content flex-container">
                        <div class="name">@T["Managing"] <br>@T["Multiple Stores"]</div>
                        <div>@T["Area Manager"]</div>
                        <div class="medium-short">4,120</div>
                        <div class="medium-short">2,500</div>
                    </div>
                    <div class="content flex-container">
                        <div class="name">@T["Managing"] <br>@T["Single Territory"]</div>
                        <div>@T["Operations Manager"]</div>
                        <div class="medium-short">5,680</div>
                        <div class="medium-short">3,500</div>
                    </div>
                    <div class="content flex-container">
                        <div class="name">@T["Managing"] <br>@T["Multiple Territories"]</div>
                        <div>@T["Operations Director/COO"]</div>
                        <div class="medium-short">6,720</div>
                        <div class="medium-short">4,500</div>
                    </div>
                </div>
                <div class="note">

                    @T["KOI Group reserves the right, at our sole discretion, to change,"] <br>@T["modify or otherwise alter the salary scale and benefits package at any time."]<br>
                    @T["The salary scale in the table represents the basic monthly salary (shown in USD)."]<br>
                    @T["Additional benefits include operations bonuses, housing allowances, regional allowances, home traveling allowances, tax subsidies, health checkup subsidies, medical insurance, annual gifts, and so on."]
                </div>
            </div>
            <div class="recruit-otherList">
                <div class="title">
                    @T["Targeting Global Talents"] <br>@T["Comprehensive Salary Benefits"]
                </div>
                <ul class="articleList">
                    <li>@T["● Competitive salary in international job markets"]</li>
                    <li>@T["● Operations bonuses"]</li>
                    <li>@T["● Medical insurance"]</li>
                    <li>
                        @T["● Allowances"]
                        <div class="note">@T["Location allowance / housing allowance / Home travel allowance / Tax rebate / Annual health check-up"]</div>
                    </li>
                    <li>
                        @T["● Paid Leave"]
                        <div class="note">
                            @T["Annual leave: 10-30 days"] <br>
                            @T["Other paid leave: sick leave, marriage leave, maternity leave, pregnancy checkup leave, paternity leave, compassionate leave."]
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <div class="recruit-middleList show-for-large">
            <section data-where="0">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-1.jpg)">
                </figure>
            </section>
            <section data-where="1">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-2.jpg)">
                </figure>
            </section>
        </div>
        <div class="recruit-middleList hide-for-large show-for-medium">
            <section data-where="0">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-1-tablet.jpg)">
                </figure>
            </section>
            <section data-where="1">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-2-tablet.jpg)">
                </figure>
            </section>
        </div>
        <div class="recruit-middleList hide-for-medium">
            <section data-where="0">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-1-mobile.jpg)">
                </figure>
            </section>
            <section data-where="1">
                <figure class="sec-bg" style="background-image: url(/images/pages/en/images/recruit-bg-2-mobile.jpg)">
                </figure>
            </section>
        </div>
        <div class="apply-area">
            <div class="head-area hide-for-large">
                <div class="head-1">
                    <div class="en top">
                        <div class="quote">“</div>@T["Apply"]
                    </div>
                </div>
                <div class="head-2">
                    <div class="en bottom">
                        @T["NOW!"]<div class="quote">”</div>
                        <div class="ch">
                            @T["We come from different places,"] <br>
                            and we bring together diverse cultures; <br>
                            @T["tea is the common language that unites us here."]
                        </div>
                    </div>
                </div>
            </div>
            <div class="apply-fancy">
                <div class="fancy-inner">
                    <div class="top-area">
                        <div class="title">@T["Apply NOW！"]</div>
                        <div class="content">
                            @T["To ensure successful submission of your resume,"] <br>
                            @T["please select only 1 application portal from below."] <br>
                            @T["DO NOT send your resume to both portals."]<br>
                            @T["Thank you."]
                        </div>
                    </div>
                    <ul class="applyList">
                        <li>
                            <a href="https://www.104.com.tw/company/1a2x6bmbm1" target="_blank" rel="noopener noreferrer">
                                <div class="title">@T["Job post on 104 portal"]</div>
                                <div class="arrow">
                                    <svg data-name="圖層 2" xmlns="http://www.w3.org/2000/svg" width="29.31" height="25.51" viewBox="0 0 29.31 25.51">
                                        <g data-name="圖層 4">
                                            <g>
                                                <line class="e" y1="12.76" x2="26.26" y2="12.76"></line>
                                                <path class="d" d="M8.93,24.93c-.38-.59-.2-1.37,.39-1.75L25.68,12.76,9.32,2.34c-.59-.38-.77-1.16-.39-1.75,.38-.59,1.17-.76,1.75-.39L28.72,11.69c.36,.23,.59,.64,.59,1.07s-.22,.84-.59,1.07L10.68,25.31c-.21,.13-.45,.2-.68,.2-.42,0-.83-.21-1.07-.59Z"></path>
                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </a>
                        </li>
                        <li>
                            <a href="mailto:globalcareers@@koicafe.com">
                                <div class="note">@T["Please send your resume to Global Recruitment Team"]</div>
                                <div class="title">@T["globalcareers"]<br class="hide-for-large">@@koicafe.com </div>
                                <div class="arrow">
                                    <svg data-name="圖層 2" xmlns="http://www.w3.org/2000/svg" width="29.31" height="25.51" viewBox="0 0 29.31 25.51">
                                        <g data-name="圖層 4">
                                            <g>
                                                <line class="e" y1="12.76" x2="26.26" y2="12.76"></line>
                                                <path class="d" d="M8.93,24.93c-.38-.59-.2-1.37,.39-1.75L25.68,12.76,9.32,2.34c-.59-.38-.77-1.16-.39-1.75,.38-.59,1.17-.76,1.75-.39L28.72,11.69c.36,.23,.59,.64,.59,1.07s-.22,.84-.59,1.07L10.68,25.31c-.21,.13-.45,.2-.68,.2-.42,0-.83-.21-1.07-.59Z"></path>
                                            </g>
                                        </g>
                                    </svg>
                                </div>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="head-area show-for-large">
                <div class="head-1">
                    <div class="en top">@T["“Apply"]</div>
                </div>
                <div class="head-2">
                    <div class="en bottom">@T["NOW!”"]
                        <div class="ch">
                            @T["We come from different places, and we bring together diverse cultures;"] <br>
                            @T["tea is the common language that unites us here."]
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@section VendorScripts {
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" defer></script>
}
@section Scripts {
    <script src="~/js/content-pages.js" asp-append-version="true" defer></script>
}
