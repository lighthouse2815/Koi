<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>koi-web-development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="code/Data/Stores.json" LogicalName="Koi.Web.Data.Stores.json" />
    <EmbeddedResource Include="code/Data/NewsSeed.json" LogicalName="Koi.Web.Data.NewsSeed.json" />
    <EmbeddedResource Include="code/Data/DrinksSeed.json" LogicalName="Koi.Web.Data.DrinksSeed.json" />
    <EmbeddedResource Include="code/Data/VietnameseSeed.json" LogicalName="Koi.Web.Data.VietnameseSeed.json" />
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <Content Remove="wwwroot/uploads/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
