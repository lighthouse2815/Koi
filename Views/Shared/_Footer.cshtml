<aside class="floating-bear" aria-label="Quick links to menu and stores" tabindex="0">
    <div class="circle" aria-hidden="true">
        <img class="mascot-menu" src="~/images/m-menu.svg" alt="" />
        <img class="mascot-store" src="~/images/m-store.svg" alt="" />
        <img class="mascot-mobile" src="~/images/m-text-mobile.svg" alt="" />
    </div>
    <div class="hover-link">
        <div class="menu"><a href="@Url.Action("Index", "Home")#drinks" aria-label="Explore the menu"><img src="~/images/m-hover-menu.svg" alt="" /></a></div>
        <div class="store"><a href="https://koithe.com/en/store.php" aria-label="Find a KOI store"><img src="~/images/m-hover-store.svg" alt="" /></a></div>
    </div>
    <div class="bear" aria-hidden="true">
        <div class="drink"><img src="~/images/b-drink-menu.svg" alt="" /></div>
        <div class="big-body"><img src="~/images/b-big-body.svg" alt="" /></div>
    </div>
</aside>
<footer class="site-footer" id="footer">
    <div class="footer-marquee" aria-hidden="true">
        <div class="footer-marquee-track" data-marquee-speed="120">
            @for (var copy = 0; copy < 2; copy++)
            {
                <ul class="footer-marquee-letters">
                    @for (var letter = 1; letter <= 13; letter++)
                    {
                        <li><img src="~/images/footer-@(letter).svg" alt="" /></li>
                    }
                </ul>
                <img class="footer-mobile-art" src="~/images/footer-wordmark.svg" width="2656" height="365" alt="" loading="lazy" />
            }
        </div>
    </div>
    <div class="footer-top"><a href="#home"><span aria-hidden="true">↑</span>( Top )</a></div>
    <div class="footer-bottom">
        <div class="footer-brand">
            <div class="footer-bear" aria-hidden="true">
                <img class="bear-body" src="~/images/bear-body.svg" alt="" loading="lazy" />
                <img class="bear-head" src="~/images/bear-head.svg" alt="" loading="lazy" />
                <img class="bear-drink" src="~/images/bear-drink.svg" alt="" loading="lazy" />
            </div>
            <a asp-controller="Home" asp-action="Index" aria-label="KOI Thé home"><img src="~/images/footer-logo.svg" width="184" height="39" alt="KOI Thé" loading="lazy" /></a>
        </div>
        <nav class="footer-navigation" aria-label="Footer navigation">
            <span class="navigation-caption">(NAVIGATION)</span>
            <div>
                <a asp-controller="Home" asp-action="Index">HOME</a>
                <a asp-controller="Home" asp-action="About">ABOUT</a>
                <a asp-controller="Home" asp-action="OurTea">OUR TEA</a>
            </div>
            <div>
                <a href="@Url.Action("Index", "Home")#news">NEWS</a>
                <a href="https://koithe.com/en/store.php">STORE</a>
                <a href="https://koithe.com/en/recruit.php">RECRUIT</a>
            </div>
            <div>
                <a href="https://koithe.com/en/impact_list.php">IMPACT</a>
                <a href="https://koithe.com/en/contact.php">CONTACT</a>
                <a href="@Url.Action("Index", "Home")#drinks">MENU</a>
            </div>
        </nav>
        <div class="footer-copyright"><span class="footer-language">EN</span><p>© @DateTime.UtcNow.Year KOI CAFE GROUP (S) PTE LTD.<br />All rights reserved.</p></div>
    </div>
</footer>
