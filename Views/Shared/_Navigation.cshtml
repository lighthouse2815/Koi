@{
    var pages = new[]
    {
        (Label: "HOME", Url: Url.Action("Index", "Home")!),
        (Label: "ABOUT", Url: "https://koithe.com/en/about.php"),
        (Label: "OUR TEA", Url: "https://koithe.com/en/ourtea.php"),
        (Label: "NEWS", Url: "https://koithe.com/en/news.php"),
        (Label: "STORE", Url: "https://koithe.com/en/store.php"),
        (Label: "RECRUIT", Url: "https://koithe.com/en/recruit.php"),
        (Label: "IMPACT", Url: "https://koithe.com/en/impact_list.php"),
        (Label: "CONTACT", Url: "https://koithe.com/en/contact.php")
    };
}
<header class="site-header">
    <a class="current-page" asp-controller="Home" asp-action="Index" aria-label="Home, page 1 of 8" aria-current="page">
        <img src="~/images/page-icon.svg" width="36" height="35" alt="" />
        <span class="page-marker" aria-hidden="true">▸</span>
        <span>HOME <i>(01/08)</i></span>
    </a>
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="KOI Thé home">
        <picture>
            <source media="(max-width: 1024px)" srcset="/images/logo-mobile.svg" />
            <img src="~/images/logo.svg" width="184" height="39" alt="KOI Thé" />
        </picture>
    </a>
    <nav class="fan-navigation" aria-label="Main navigation">
        <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-haspopup="dialog" aria-controls="navigation-dialog">
            <span class="mobile-menu-label"><img src="~/images/hamburger.svg" width="23" height="17" alt="" /></span>
        </button>
        <ul class="fan-links">
            @foreach (var navItem in pages)
            {
                <li><a href="@navItem.Url" aria-current="@(navItem.Label == "HOME" ? "page" : null)">@navItem.Label</a></li>
            }
        </ul>
    </nav>
</header>
<dialog class="navigation-dialog" id="navigation-dialog" aria-labelledby="navigation-title">
    <div class="dialog-heading">
        <span id="navigation-title">EXPLORE KOI</span>
        <button class="menu-close" type="button" aria-label="Close navigation menu">×</button>
    </div>
    <nav aria-label="Expanded navigation">
        @foreach (var navItem in pages)
        {
            <a href="@navItem.Url" aria-current="@(navItem.Label == "HOME" ? "page" : null)"><span>@navItem.Label</span><span aria-hidden="true">↗</span></a>
        }
    </nav>
    <div class="dialog-bottom"><span>YOUR DAILY BEAT.</span><span lang="en">ENGLISH</span></div>
</dialog>
