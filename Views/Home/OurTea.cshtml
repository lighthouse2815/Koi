@model OurTeaViewModel
@{
    ViewData["Title"] = T["Our Tea__text"].Value;
}
@section Styles {
    <link rel="stylesheet" href="~/lib/swiper/swiper-bundle.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ourtea.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/content-pages.css" asp-append-version="true" />
}
<div class="content-page" id="home">
