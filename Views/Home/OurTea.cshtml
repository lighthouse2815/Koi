                                    <path class="d" d="M62.05,51.62c-.86,0-1.6-.17-2.23-.51s-1.12-.82-1.46-1.45-.52-1.36-.52-2.21v-5.23h2.28v5.23c0,.42,.08,.78,.24,1.09,.16,.31,.39,.55,.68,.72,.3,.17,.64,.25,1.03,.25s.74-.08,1.03-.25c.29-.17,.51-.41,.67-.72s.24-.68,.24-1.09v-5.23h2.28v5.23c0,.84-.17,1.57-.52,2.2-.35,.63-.84,1.11-1.47,1.46s-1.37,.52-2.23,.52Z"></path>
                                </g>
                            </g>
                        </svg>
                    </a>
                </div>
                <ul class="drink-fixedList">
                    @foreach (var category in Model.Categories)
                    { <li data-scroll="@category.Id" class="flex-container align-middle"><div class="dot"></div><div class="title">@SiteText.Select(category.Name, category.NameVi)</div></li> }
                </ul>
            </div>
            <div class="drinkList-pic">
                @for (var index = 0; index < Model.Categories.Length; index++)
                {
                    var category = Model.Categories[index];
                    <ul class="area-@(index + 1)">
                        <li class="is-show"><img src="@category.Image" alt="" /></li>
                        @foreach (var drink in category.Drinks)
                        { <li><img src="@(string.IsNullOrEmpty(drink.Image) ? category.Image : drink.Image)" alt="" /></li> }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
@section VendorScripts {
