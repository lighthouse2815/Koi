@{
    ViewData["Title"] = "Your Daily Beat";
    var speeds = new[] { 60, 90, 120, 60, 180, 90, 120, 60, 120, 90, 60, 180, 90, 90, 60, 120 };
    var drinks = new[]
    {
        (Image: "chewy", Label: "CHEWY TEA", Id: "45"),
        (Image: "flavored", Label: "FLAVORED TEA", Id: "4"),
        (Image: "macchiato", Label: "SIGNATURE MACCHIATO", Id: "44"),
        (Image: "milk", Label: "MILK TEA", Id: "5"),
        (Image: "latte", Label: "TEA LATTE", Id: "43"),
        (Image: "juice", Label: "JUICE", Id: "6")
    };
}
<dialog class="intro" id="intro" aria-label="KOI Thé introduction" hidden>
    <video class="intro-video" src="~/videos/intro.mp4" muted playsinline preload="none" aria-hidden="true"></video>
    <button class="intro-skip" type="button">( Skip ) <span aria-hidden="true">→</span></button>
</dialog>
<div class="hero-track" id="home">
<section class="hero" aria-labelledby="hero-title">
    <h1 class="visually-hidden" id="hero-title">KOI Thé — Your Daily Beat</h1>
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/hero-reading-poster.jpg" aria-hidden="true">
        <source src="~/videos/hero-reading-desktop.mp4" type="video/mp4" media="(min-width: 1025px)" />
        <source src="~/videos/hero-reading-tablet.mp4" type="video/mp4" media="(min-width: 640px)" />
        <source src="~/videos/hero-reading-mobile.mp4" type="video/mp4" />
    </video>
    <div class="hero-lettering" aria-hidden="true">
        <picture>
            <source media="(max-width: 1024px)" srcset="/images/hero-reading-wordmark-mobile.png" />
            <img class="hero-wordmark" src="~/images/hero-wordmark.svg" alt="" fetchpriority="high" />
        </picture>
        <div class="hero-o">
            <img class="hero-ring" src="~/images/hero-ring.svg" alt="" />
            <img class="hero-center" src="~/images/hero-reading-center.png" alt="" fetchpriority="high" />
        </div>
    </div>
    <div class="hero-bottom">
        <a class="scroll-prompt" href="#our-story" aria-label="Scroll to explore more"><picture><source media="(max-width: 1024px)" srcset="/images/scroll-mobile.svg" /><img src="~/images/scroll-desktop.svg" width="170" height="81" alt="" /></picture></a>
        <p class="hero-note">Happiness is to share special moments with friends. A celebration, a date or just a relaxing break in the day, there is always a reason to get together around a cup of KOI tea. KOI brings joy to the world. Freshly brewed tea and flavorful ingredients, prepared with passion are the key to KOI’s authentic taste and the reason why people come back again and again.</p>
        <button class="intro-replay" type="button">( Replay intro )</button>
        <button class="motion-toggle" type="button" aria-label="Pause background video" aria-pressed="false">Ⅱ <span>PAUSE</span></button>
    </div>
</section>
</div>
<section class="story" id="our-story" aria-labelledby="story-title">
    <h2 class="visually-hidden" id="story-title">A little care in every cup</h2>
    <div class="story-stage">
    <div class="story-lines" aria-hidden="true">
        @for (var row = 0; row < 16; row++)
        {
            <div class="story-line"><div data-marquee-speed="@speeds[row]">@for (var repeat = 0; repeat < 16; repeat++) { <span><img src="~/images/index-bg-text-@(row % 8 + 1).svg" alt="" /></span> }</div></div>
        }
    </div>
    <div class="story-cup" role="img" aria-label="Freshly brewed milk tea turning as you scroll">
        <div class="story-sprite"><img src="~/images/tea-top.png" width="459" height="459" alt="" loading="lazy" /></div>
    </div>
    <div class="story-wipe" aria-hidden="true"></div>
    <div class="daily-marquee" aria-hidden="true"><div data-marquee-speed="120"><img src="~/images/marquee.svg" alt="" loading="lazy" /><img src="~/images/marquee.svg" alt="" loading="lazy" /></div></div>
    </div>
</section>
<section class="feature-intro" aria-hidden="true">
    <partial name="_FeatureStage" model="true" />
</section>
<section class="features" aria-labelledby="features-title">
    <h2 class="visually-hidden" id="features-title">Made with care. Shared with joy.</h2>
    <partial name="_FeatureStage" model="false" />
</section>
<section class="recommendation" aria-labelledby="recommendation-title">
    <div class="recommendation-stage">
    <p class="recommendation-label">OUR<br />RECOMMENDATION</p>
    <h2 id="recommendation-title">GOLDEN BUBBLE MILK TEA<br />HONEY GREEN TEA</h2>
    <div class="recommendation-art">
        <div class="recommendation-layer splash splash-left" data-depth="-4.4"><img src="~/images/splash-left.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer splash splash-right" data-depth="-4.5"><img src="~/images/splash-right.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit orange-one" data-depth="-2"><img src="~/images/orange-1.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit orange-two" data-depth="-2.5"><img src="~/images/orange-3.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit orange-three" data-depth="-1.8"><img src="~/images/orange-2.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit strawberry-one" data-depth="-4.8"><img src="~/images/strawberry-1.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit strawberry-two" data-depth="-6.5"><img src="~/images/strawberry-3.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer fruit strawberry-three" data-depth="-5"><img src="~/images/strawberry-2.png" alt="" loading="lazy" /></div>
        <div class="recommendation-layer recommended-drink milk-tea" data-depth="-5"><img src="~/images/drink-milk-tea.png" alt="Golden Bubble Milk Tea" width="287" height="465" loading="lazy" /></div>
        <div class="recommendation-layer recommended-drink green-tea" data-depth="-6.5"><img src="~/images/drink-green-tea.png" alt="Honey Green Tea" width="287" height="465" loading="lazy" /></div>
    </div>
    <div class="recommendation-captions"><span>GOLDEN BUBBLE MILK TEA</span><span>HONEY GREEN TEA</span></div>
    </div>
</section>
<div class="drinks-track">
<section class="drinks-section" id="drinks" aria-labelledby="drinks-title">
    <h2 class="section-heading green" id="drinks-title"><span class="heading-clip"><span class="heading-word">DRINK</span></span></h2>
    <div class="drink-controls"><span>FIND YOUR DAILY FAVOURITE</span><div><button type="button" class="carousel-arrow" data-drink-direction="-1" aria-label="Previous drinks" aria-controls="drink-carousel">←</button><button type="button" class="carousel-arrow" data-drink-direction="1" aria-label="Next drinks" aria-controls="drink-carousel">→</button></div></div>
    <div class="drink-carousel" id="drink-carousel" tabindex="0" role="region" aria-label="Drink categories, scroll horizontally">
        @foreach (var drink in drinks)
        {
            <a class="drink-card" href="@Url.Action("OurTea", "Home")#@drink.Id">
                <div class="drink-photo">
                    <img src="~/images/drink-@(drink.Image).jpg" alt="@drink.Label collection" width="600" height="600" loading="lazy" />
                    <img class="drink-photo-circle" src="~/images/drink-@(drink.Image).jpg" alt="" width="600" height="600" loading="lazy" aria-hidden="true" />
                    <span class="drink-view-more" aria-hidden="true">VIEW<br />MORE ↗</span>
                </div>
                <h3><img src="~/images/icon-@(drink.Image).svg" alt="" width="32" height="44" loading="lazy" />@drink.Label<span aria-hidden="true">↗</span></h3>
            </a>
        }
    </div>
</section>
</div>
<section class="news-section" id="news" aria-labelledby="news-title">
    <h2 class="section-heading gold" id="news-title"><span class="heading-clip"><span class="heading-word">NEWS</span></span></h2>
    <div class="news-carousel" role="region" aria-roledescription="carousel" aria-label="Latest news">
        <div class="news-pagination" aria-label="Choose a news article">
            <button type="button" data-news-slide="0" aria-label="Show news 1" aria-pressed="true" aria-controls="news-1">01</button>
            <button type="button" data-news-slide="1" aria-label="Show news 2" aria-pressed="false" aria-controls="news-2">02</button>
        </div>
        <div class="news-slides">
        <article class="news-slide" id="news-1" aria-roledescription="slide" aria-label="1 of 2">
            <a asp-action="NewsDetail" asp-route-id="2782" class="news-link">
                <img class="news-image" src="~/images/news-badges.jpg" alt="Colourful KOI tea magnets from around the world on a yellow background" width="840" height="520" loading="lazy" />
                <div class="news-copy"><time datetime="2025-12-31">(December 31, 2025)</time><h3>“CLOCK IN the world with KOI” Global Magnet Badge Collection Challenge</h3><span class="news-more"><span aria-hidden="true">→</span>( More )</span></div>
            </a>
        </article>
        <article class="news-slide" id="news-2" aria-roledescription="slide" aria-label="2 of 2" hidden>
            <a asp-action="NewsDetail" asp-route-id="7" class="news-link">
                <img class="news-image" src="~/images/news-website.jpg" alt="KOI Thé celebrates its new official website" width="840" height="520" loading="lazy" />
                <div class="news-copy"><time datetime="2024-12-01">(December 01, 2024)</time><h3>Welcome to the brand-new official website! Explore and experience the unique charm of KOI.</h3><span class="news-more"><span aria-hidden="true">→</span>( More )</span></div>
            </a>
        </article>
        </div>
    </div>
</section>

@section VendorScripts {
    <script src="~/lib/gsap/gsap.min.js" defer></script>
    <script src="~/lib/gsap/ScrollTrigger.min.js" defer></script>
    <script src="~/lib/gsap/ScrollToPlugin.min.js" defer></script>
}
@section Scripts {
    <script src="~/js/home-animations.js" asp-append-version="true" defer></script>
}
