@model FeaturedDrinkEditViewModel
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Sửa New Drinks" : "Thêm New Drinks"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a asp-action="Index">← New Drinks</a></div>
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : (int?)null)" method="post" enctype="multipart/form-data" class="editor">
<input asp-for="Id" type="hidden" /><input asp-for="Revision" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="editor-columns"><div class="card">
<fieldset><legend>Nội dung tiếng Việt</legend><p class="help">Để trống để dùng nội dung gốc. Nội dung tiếng Anh được giữ riêng.</p>
<label asp-for="NameVi">Tên tiếng Việt</label><input asp-for="NameVi" maxlength="250" />
<label asp-for="RegionVi">Khu vực tiếng Việt</label><input asp-for="RegionVi" maxlength="150" />
</fieldset>

<label asp-for="Name">Tên đồ uống / bộ sưu tập</label><input asp-for="Name" maxlength="250" required />
<label asp-for="Region">Quốc gia / khu vực</label><input asp-for="Region" maxlength="150" />
<label asp-for="ImageUpload">Ảnh đồ uống</label>@if (!string.IsNullOrEmpty(Model.CurrentImage)) { <img class="current-image" src="@Model.CurrentImage" alt="Ảnh hiện tại" /> }<input asp-for="ImageUpload" type="file" accept="image/jpeg,image/png,image/webp" required="@(!editing)" />
<label asp-for="BackgroundUpload">Ảnh nền</label>@if (!string.IsNullOrEmpty(Model.CurrentBackground)) { <img class="current-image" src="@Model.CurrentBackground" alt="Ảnh nền hiện tại" /> }<input asp-for="BackgroundUpload" type="file" accept="image/jpeg,image/png,image/webp" required="@(!editing)" />
<p class="help">Mỗi ảnh JPG, PNG hoặc WebP tối đa 5 MB. Khi sửa, để trống để giữ ảnh cũ.</p>
</div><aside class="card">
<label class="check"><input asp-for="IsPublished" /> Hiển thị trên Our Tea</label>
<label asp-for="SortOrder">Thứ tự</label><input asp-for="SortOrder" type="number" min="0" max="100000" /><p class="help">Số nhỏ hiển thị trước.</p>
<button class="button" type="submit">Lưu New Drinks</button>@if (editing) { <a asp-action="Edit" asp-route-id="@Model.Id">Tải lại bản mới nhất</a> }
</aside></div></form>
