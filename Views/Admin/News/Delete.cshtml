@model NewsArticle
@{
    ViewData["Title"] = "Xóa bài viết";
}
<section class="card delete-card">
    <h1>Xóa bài viết?</h1>
    <p><strong>@Model.Title</strong></p>
    <p>Bài viết sẽ được gỡ khỏi News và trang chủ.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="button danger">Xác nhận xóa</button><a asp-action="Index">Hủy</a></form>
</section>
